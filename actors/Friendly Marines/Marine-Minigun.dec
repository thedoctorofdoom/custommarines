ACTOR Marine_Minigun: PBMarine{
	Scale 1.05
	DropItem "MinigunMarineDrop"
	PBMarine.AllyCountedInventory "NumberOfAlliesMinigun"
	PBMarine.AllyMapCounter "NumberOfAlliesMinigunThisMap"
	Translation  "112:127=32:47", "48:79=64:79"
	PBMarine.MarineWeapon "PB_Minigun"
	Obituary "%o has been gunned down by a Minigun Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PL42 E 0 A_StopSound(1)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PL42 A 30
		TNT1 A 0 MarineModeSpawn("MinigunMarineGuarding")
		Stop
		
	Spawn:
		PL42 A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PL42 AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PL42 A 1
		goto BecomeEnemy24
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PL42 A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PL42 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PL42 H 1
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PL42 HE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PL42 E 8 A_Stop
		
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PL42 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PL42 E 8 A_Stop
		
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PL42 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PL42 A 10 A_FaceTarget
		PL42 I 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	GiveHealth:
		PL42 A 10 A_FaceTarget
		PL42 J 30 A_StartVoiceLine("MRNGI2")
		goto HandOverStimpack
	
	//Missile:
		PL42 E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)

	Missile2:	
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 A_JumpIfCloser(500, "Missile3")
		PL42 E 2 A_FaceTarget
	Missile2Continue:
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPLayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire",16)
	Missile2Loop:
		PL42 FEE 1//FEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEE 
		TNT1 A 0 A_JumpIfFireAction("Missile2Loop")
		TNT1 A 0 A_MarineRefire(40)
		Goto Missile2Continue
	Missile3:
		PL42 E 12 A_StartSound("CHAINSTA", CHAN_AUTO)
	Missile3Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire2",12)
		PL42 FEFEFEFEFEFEFEFEFEFEFEFE 1 BRIGHT
		TNT1 A 0 A_JumpIfCloser(500,"Missile3SeqEnd")
		PL42 E 0 A_StopSound(1)
		TNT1 A 0 A_Jump(256,"Missile3Finish")
	Missile3SeqEnd:
		TNT1 A 0 A_MarineRefire(40, "Missile3Finish")
		Goto Missile3Continue
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
	Missile3Finish:
		PL42 E 2 A_StopSound(1)
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfReloading("See")
		Goto Missile2
		
	StrafeRight:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfReloading("See")
		Goto Missile2
	Retreat:
		PL42 A 3 A_FaceTarget
		PL42 B 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		PL42 CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PL42 G 3 A_StopSound(1)
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PL42 G 3 A_Pain
		Goto FollowPlayer

	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PL42 H 10 A_PlayerScream
		PL42 I 10 A_NoBlocking
		PL42 J 10 
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineMinigun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PL42 KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PL42 N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PL42 O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineMinigun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PL42 OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PL42 U -1
		Stop
	}
}

ACTOR MinigunMarineGuarding: Marine_Minigun{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		PL42 E 0 A_StopSound(1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PL42 A 30
		TNT1 A 0 MarineModeSpawn("Marine_Minigun")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PL42 E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		PL42 EEEEEEEEEEHHHHHHHHH 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
				
	//Missile:
		//PL42 E 1
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_JumpIfTargetIsMarine("See")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
		/*
	Missile2:	
		TNT1 A 0 A_JumpIfCloser(500, "Missile3")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PL42 E 2 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire2",18)
		PL42 FEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEE 1
		TNT1 A 0 A_CPosRefire
		Goto Missile2+1
		*/
	Missile3:
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		PL42 E 12 A_StartSound("CHAINSTA", CHAN_AUTO)
	Missile3Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire2",12)
		PL42 FEFEFEFEFEFEFEFEFEFEFEFE 1 BRIGHT
		TNT1 A 0 A_MonsterRefire(40, "Missile3Finish")//A_CPosREfire
		Goto Missile3Continue
	Missile3Finish:
		PL42 E 0 A_StopSound(1)
		Goto Missile3Continue
	Pain:
		PL42 G 3
		PL42 G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		//TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}

