ACTOR Marine_Nailgun: PBMarine{
	Scale 1.05
	DropItem "NailgunMarineDrop"
	Translation "112:127=[64,128,64]:[0,0,0]"
	PBMarine.MarineWeapon "PB_Nailgun"
	PBMarine.AllyCountedInventory "NumberOfAlliesNailgun"
	PBMarine.AllyMapCounter "NumberOfAlliesNailgunThisMap"
	Obituary "%o has been gunned down by a Nailgun Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PL42 A 30
		TNT1 A 0 MarineModeSpawn("NailgunMarineGuarding")
		Stop
		
	Spawn:
		PL42 A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 A_StopSound(CHAN_BODY)
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PL42 AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PL42 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PL42 A 1
		goto BecomeEnemy24
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PL42 A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PL42 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PL42 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PL42 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PL42 H 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PL42 HE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PL42 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PL42 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PL42 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PL42 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PL42 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PL42 A 10 A_FaceTarget
		PL42 K 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	GiveHealth:
		PL42 A 10 A_FaceTarget
		PL42 J 30 A_StartVoiceLine("MRNGI2")
		goto HandOverStimpack
	
	//Missile:
		PL42 E 1
	MissileSequence:
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
	Missile2:
	Missile.Nailgun:
		TNT1 A 0 A_JumpIfHealthLower(360,2,AAPTR_TARGET)
		TNT1 A 0 A_JumpIfCloser(600,1)
		goto Missile.Nailgun.Javelin
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(220)>1,"Missile.Nailgun.Alt")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPLayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_PlaySound("weapons/chagan/start")
		PL42 EEE 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
	Missile.Nailgun.Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineNailgunFire",4)
		PL42 FEEFEEFEEFEE 1 
		TNT1 A 0 A_JumpIfCloser(500,2)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_MarineRefire(40, "Missile.Nailgun.Done")
		Goto Missile.Nailgun.Continue
	Missile.Nailgun.Alt:
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Nailgun",null,20)
		PL42 E 4 A_StartSound("weapons/nailgun/altcharge", CHAN_AUTO)
		PL42 E 18 A_StartSound("weapons/nailgun/inspect4", CHAN_AUTO)
		TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, Random(-10, 10), 0, Random(-10, 10))
		PL42 F 3 BRIGHT {D_DoMarineDelayFireFX("MarineNailgunAltfireSequence");D_DepleteWeaponAmmo("PB_Nailgun",20);A_FaceTarget;A_StartSound("weapons/nailgun/altfire", CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Javelin:
		TNT1 A 0 A_Jump(128,"Missile.Nailgun.Javelin.Alt")
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Nailgun",null,20)
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun",null,20)){A_FaceTarget;D_DoMarineDelayFireFX("MarineNailgunJavelinSequence");A_StartSound("weapons/nailgun/javelinfire",CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo("PB_Nailgun",20);A_SpawnGravityProjectile("PBMarine_JavelinProjectile", 34, 2, 0, 0, 0);}}
		PL42 E 2 
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Javelin.Alt:
		PL42 E 33 {if(!D_AbortAndReloadIfEmpty("PB_Nailgun",null,20)){A_StartSound("weapons/nailgun/javelincharge", CHAN_WEAPON);}}
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun",null,20)){A_FaceTarget;D_DoMarineDelayFireFX("MarineNailgunJavelinSequence");A_StartSound("weapons/nailgun/javelinfire",CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo("PB_Nailgun",20);A_SpawnGravityProjectile("PBMarine_JavelinProjectile_Hot", 34, 2, 0, 0, 0);}}
		PL42 E 2 
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Done:
		TNT1 A 0 A_PlaySound("weapons/nailgun/fireStop",CHAN_BODY, 1.0, False)
		TNT1 A 0 A_Jump(256,"See")
	StrafeLeft:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2	
	Retreat:
		TNT1 A 0
		PL42 A 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		PL42 B 3
		TNT1 A 0 A_Recoil(5)
		PL42 CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PL42 G 3 A_StopSound(CHAN_BODY)
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PL42 G 3 A_Pain
		Goto FollowPlayer

	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PL42 H 10 A_PlayerScream
		PL42 I 10 A_NoBlocking
		PL42 J 10 
		TNT1 A 0 //A_SpawnItemEx("RemovePBMarine_MGNailgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PL42 KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PL42 N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PL42 O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemovePBMarine_MGNailgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PL42 OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PL42 U -1
		Stop
	}
}

ACTOR NailgunMarineGuarding: Marine_Nailgun{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PL42 A 30
		TNT1 A 0 MarineModeSpawn("Marine_Nailgun")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PL42 E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineNailgunReload")
		PL42 EEEEEEEEEEHHHHHHHHH 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
				
	//Missile:
		//PL42 E 1
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
	Missile2:
	Missile.Nailgun:
		TNT1 A 0 A_PlaySound("weapons/chagan/start")
		PL42 EEE 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 A_PlaySound("weapons/nailgun/fireloop", CHAN_BODY, 1.0, True)
		//
	Missile.Nailgun.Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineNailgunFire",8)
		PL42 FEEFEEFEEFEEFEEFEEFEEFEE 1 
		/*
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, -2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, -2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, -2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, -2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun")){A_FaceTarget;A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo;A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, random(-6, 6), 0, random(-2, 2));}}
		PL42 E 2 
		*/
		TNT1 A 0 A_MarineRefire(40, "Missile.Nailgun.Done")
		Goto Missile.Nailgun.Continue
	Missile.Nailgun.Done:
		TNT1 A 0 A_PlaySound("weapons/nailgun/fireStop",CHAN_BODY, 1.0, False)
		TNT1 A 0 A_Jump(256,"See")
	Pain:
		PL42 G 3
		PL42 G 3 A_Pain
		TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}
