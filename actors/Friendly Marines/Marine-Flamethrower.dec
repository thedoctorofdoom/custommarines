ACTOR Marine_Flamethrower: PBMarine{
	DropItem "FlamethrowerMarineDrop"
	Translation "112:127=[92,256,0]:[0,0,0]"
	PBMarine.MarineWeapon "PB_Flamethrower"
	PBMarine.AllyCountedInventory "NumberOfAlliesFlamethrower"
	PBMarine.AllyMapCounter "NumberOfAlliesFlamethrowerThisMap"
	Obituary "%o has been gunned down by a Flamethrower Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		MMFC A 30
		TNT1 A 0 MarineModeSpawn("FlamethrowerMarineGuarding")
		Stop
		
	Spawn:
		MMFC A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 A_StopSound(CHAN_BODY)
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MMFC DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		MMFC AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MMFC BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MMFC CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MMFC DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		MMFC A 1
		goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		MMFC A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		MMFC AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		MMFC CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MMFC DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MMFC A 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		MMFC AA 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MMFC D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MMFC A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MMFC A 8 A_Stop
		
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		MMFC A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MMFC D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MMFC A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MMFC A 8 A_Stop
		
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		MMFC A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MMFC D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MMFC A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		MMFC A 10 A_FaceTarget
		MMFC J 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	
	//Missile:
		//MMFC A 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		goto Missile2
	Missile2:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
	Missile.FlameThrower:
		TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") < GetTargetDamageFactor("Fire"),"Missile.FlameThrower.Acid")
	Missile.FlameThrower.Fire:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_JumpIfCloser(500,"Missile.Flamethrower.FlameBall")
		MMFC A 6 {A_FaceTarget;A_StartSound("weapons/flamethrower/start", CHAN_6 );}
		MMFC A 6 {A_FaceTarget;A_StartSound("weapons/flamethrower/burst", CHAN_5 );}
		TNT1 A 0 A_AllyAlertMonsters(200,AMF_TARGETEMITTER)
		MMFC A 24 BRIGHT D_DoMarineFireFX("MarineFlamethrowerFire",8)
		/*
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		MMFC AAAAAAAA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower", null, 3)){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_StartSound("weapons/flamethrower/stop", CHAN_BODY)
		*/
		TNT1 A 0 A_Jump(256,"See")
	Missile.Flamethrower.FlameBall:
		MMFC A 3 BRIGHT {if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",9);A_SpawnGravityProjectile("PBMarine_BigFireBallWithGravity");}}
		TNT1 A 0 A_Jump(256,"See")
	Missile.FlameThrower.Acid:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_JumpIfCloser(500,"Missile.Flamethrower.AcidBall")
		MMFC A 6 {A_FaceTarget;}
		MMFC A 6 {A_FaceTarget;A_StartSound("weapons/flamethrower/acidstart", CHAN_BODY, CHANF_OVERLAP, 0.65 );}
		TNT1 A 0 A_AllyAlertMonsters(200,AMF_TARGETEMITTER)
		MMFC A 24 BRIGHT D_DoMarineFireFX("MarineFlamethrowerAcid",8)
		/*
		TNT1 A 0 {A_StartSound("weapons/flamethrower/acidloop", CHAN_BODY, CHANF_LOOPING, 0.5 );A_StartSound("weapons/flamethrower/acidsprayloop", CHAN_5, CHANF_LOOPING , 1.0 );}
		MMFC AAAAAAAA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/acidstop", CHAN_BODY );}
		*/
		TNT1 A 0 A_Jump(256,"See")
	Missile.Flamethrower.AcidBall:
		MMFC A 3 BRIGHT {if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",9);A_StartSound("weapons/flamethrower/acidgelshot");A_SpawnGravityProjectile("PBMarine_NukageMissile");}}
		TNT1 A 0 A_Jump(256,"See")
	StrafeLeft:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Left
		PSTN A 3 A_FaceTarget
		PSTN B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PSTN C 3 A_FaceTarget
		PSTN D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	StrafeRight:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Right
		PSTN A 3 A_FaceTarget
		PSTN B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PSTN C 3 A_FaceTarget
		PSTN D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	Retreat:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Retreat
		PSTN A 3 A_FaceTarget
		PSTN B 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		PSTN CD 3 A_FaceTarget
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
		/*
	Missile.Left:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(1000,AMF_TARGETEMITTER)
		PLAY F 0 D_DoMarineFireFX("MarineFlamethrowerFire",8)
		MMFC BCBABCBA 3 ThrustThing(angle*256/360+192, random(random(2,3),3), 0, 0)
		TNT1 A 0 A_Jump(256,"See")
	Missile.Right:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(1000,AMF_TARGETEMITTER)
		PLAY F 0 D_DoMarineFireFX("MarineFlamethrowerFire",8)
		MMFC BCBABCBA 3 ThrustThing(angle*256/360+64, random(random(2,3),3), 0, 0)
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat:
		MMFC A 3 A_FaceTarget
		PLAY F 0 D_DoMarineFireFX("MarineFlamethrowerFire",8)
		MMFC BCBABCBA 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
		*/
	Missile.Left:
	Missile.Left.Flamethrower:
		TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") < GetTargetDamageFactor("Fire"),"Missile.Left.Flamethrower.Acid")
	Missile.Left.Flamethrower.Fire:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 {A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/stop", CHAN_BODY);}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Left.Flamethrower.Acid:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/acidstop", CHAN_BODY );}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Right:
	Missile.Right.Flamethrower:
		TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") < GetTargetDamageFactor("Fire"),"Missile.Right.Flamethrower.Acid")
	Missile.Right.Flamethrower.Fire:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 {A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/stop", CHAN_BODY);}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Right.Flamethrower.Acid:
		MMFC A 3 A_FaceTarget
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/acidstop", CHAN_BODY );}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat:
	Missile.Retreat.Flamethrower:
		TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") < GetTargetDamageFactor("Fire"),"Missile.Retreat.Flamethrower.Acid")
	Missile.Retreat.Flamethrower.Fire:
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		MMFC A 3 {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 {A_StartSound("weapons/flamethrower/stop", CHAN_AUTO, CHANF_OVERLAP );A_StopSound(CHAN_BODY);}
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.Flamethrower.Acid:
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		MMFC A 3 {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/acidstop", CHAN_BODY );}
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Pain:
		MMFC G 3 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);}
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		MMFC G 3 A_Pain
		Goto FollowPlayer
	}
}

ACTOR FlamethrowerMarineGuarding: Marine_Flamethrower{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		MMFC A 30
		TNT1 A 0 MarineModeSpawn("Marine_Flamethrower")
		Stop
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		MMFC A 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
	See:
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineFlameThrowerReload")
		MMFC AAAAAAAAAAJJJJJJJJJ 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
	Pain:
		MMFC G 3 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);}
		MMFC G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		//TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		MMFC A 3 A_FaceTarget
		MMFC B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MMFC C 3 A_FaceTarget
		MMFC D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		MMFC A 3 A_FaceTarget
		MMFC B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MMFC C 3 A_FaceTarget
		MMFC D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}
