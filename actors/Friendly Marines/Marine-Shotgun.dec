ACTOR Marine_Shotgun: PBMarine{
	DropItem "ShotgunMarineDrop"
	DropItem "PB_GrenadeAmmo", 7
	Translation "112:127=96:111"
	PBMarine.AllyCountedInventory "NumberOfAlliesShotgun"
	PBMarine.AllyMapCounter "NumberOfAlliesShotgunThisMap"
	PBMarine.MarineWeapon "PB_Shotgun"
	Obituary "%o has been gunned down by a Shotgun Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PLA3 A 30
		TNT1 A 0 MarineModeSpawn("ShotgunMarineGuarding")
		Stop
		
	Spawn:
		PLA3 A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		//TNT1 A 0 PrintWeaponIndices
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA3 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		
		PLA3 AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA3 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA3 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA3 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PLA3 A 1
		goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PLA3 A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PLA3 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		PLA3 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PLA3 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA3 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		
		
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PLA3 H 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PLA3 HE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA3 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA3 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PLA3 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA3 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA3 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PLA3 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA3 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PLA3 A 10 A_FaceTarget
		PLA3 I 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	GiveHealth:
		PLA3 A 10 A_FaceTarget
		PLA3 L 30 A_StartVoiceLine("MRNGI2")
		goto HandOverStimpack
	GiveWeaponCRTW:
		MR7S BCA 10 A_FaceTarget
		MR8S CD 15
		goto HandOverWeaponCRTW
	//Missile:
		PLA3 E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
	Missile2:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		//7
		/*
		PLA3 E 2 A_FaceTarget
		PLA3 J 2
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		*/
	Missile.Shotgun:
		PLA3 E 6 A_FaceTarget
		TNT1 A 0 A_JumpIf(GetPBTier < 2,2)
		TNT1 A 0 A_JumpIfCloser(400, 1)
		goto Missile.Shotgun.Slug
	Missile.Shotgun.Shot:
		TNT1 A 0 A_Jump(128,"Missile.Shotgun.Shot.B")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		TNT1 A 0 {D_DepleteWeaponAmmo;PBCM_SpawnProjectiles(9,"PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3));A_PlaySound("weapons/sg", 1);A_SpawnProjectile("ShotgunWad", 32);}
		PLA3 F 3 BRIGHT D_DoMarineDelayFireFX("MarineShotgunPump")
		PLA3 E 3 A_FaceTarget
		TNT1 A 0 A_Jump(256,"See")
	Missile.Shotgun.Shot.B:
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {D_DepleteWeaponAmmo;PBCM_SpawnProjectiles(9,"PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3));A_PlaySound("weapons/sg", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_MonsterRefire(128, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {D_DepleteWeaponAmmo;PBCM_SpawnProjectiles(9,"PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3));A_PlaySound("weapons/sg", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_MonsterRefire(128, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {D_DepleteWeaponAmmo;PBCM_SpawnProjectiles(9,"PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3));A_PlaySound("weapons/sg", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_MonsterRefire(128, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {D_DepleteWeaponAmmo;PBCM_SpawnProjectiles(9,"PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3));A_PlaySound("weapons/sg", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,"See")
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_Jump(256,"See")
	Missile.Shotgun.Slug:
		TNT1 A 0 A_Jump(128,"Missile.Shotgun.Slug.B")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {PBCM_SpawnProjectile("PBMarine_12GASlug", 32);D_DoMarineDelayFireFX("MarineShotgunPumpSlug");}
		PLA3 E 3 A_FaceTarget
		TNT1 A 0 A_Jump(256,"See")
	Missile.Shotgun.Slug.B:
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {PBCM_SpawnProjectile("PBMarine_12GASlug", 32);D_DepleteWeaponAmmo;A_PlaySound("SlugShot", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_MonsterRefire(128, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {PBCM_SpawnProjectile("PBMarine_12GASlug", 32);D_DepleteWeaponAmmo;A_PlaySound("SlugShot", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_MonsterRefire(128, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		PLA3 F 3 BRIGHT {PBCM_SpawnProjectile("PBMarine_12GASlug", 32);D_DepleteWeaponAmmo;A_PlaySound("SlugShot", 1);A_SpawnProjectile("ShotgunWad", 32);}
		
		PLA3 E 6 A_JumpIfInventory("PB_PowerStrength",1,6)
		PLA3 J 6 A_PlaySound("weapons/sgpump", 3)
		PLA3 K 6 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PLA3 J 6
		TNT1 A 0 A_Jump(256,5)
		PLA3 EJ 2 A_FaceTarget
		PLA3 K 6 A_PlaySoundEx("weapons/sgmvpump", Auto)
		PLA3 J 5 {A_PlaySoundEx("weapons/sgpump","Auto");A_SpawnItem("ShotCaseSpawn", 0, 30,0);}
		
		TNT1 A 0 A_Jump(256,"See")
	StrafeLeft:
		PLA3 A 3 A_FaceTarget
		PLA3 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA3 C 3 A_FaceTarget
		PLA3 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
		
	StrafeRight:
		PLA3 A 3 A_FaceTarget
		PLA3 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA3 C 3 A_FaceTarget
		PLA3 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2	
	Retreat:
		PLA3 A 3 A_FaceTarget
		PLA3 B 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		PLA3 CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PLA3 G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PLA3 G 3 A_Pain
		Goto FollowPlayer

	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PLA3 H 10 A_PlayerScream
		PLA3 I 10 A_NoBlocking
		PLA3 J 10 
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PLA3 KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PLA3 N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PLA3 O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PLA3 OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PLA3 U -1
		Stop
	}
}
ACTOR ShotgunMarineGuarding: Marine_Shotgun{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PLA3 A 30
		TNT1 A 0 MarineModeSpawn("Marine_Shotgun")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PLA3 E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineShotgunReload")
		PLA3 EEEEEEEEEEHHHHHHHHH 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
			
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
	Pain:
		PLA3 G 3
		PLA3 G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		TNT1 A 0 A_Jump(256,"See")
	}
}

