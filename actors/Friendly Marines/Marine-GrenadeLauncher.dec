ACTOR Marine_GrenadeLauncher: PBMarine{
	DropItem "GrenadeLauncherMarineDrop"
	Translation "112:127=144:151"
	PBMarine.MarineWeapon "PB_SuperGL"
	PBMarine.AllyCountedInventory "NumberOfAlliesGL"
	PBMarine.AllyMapCounter "NumberOfAlliesGLThisMap"
	Obituary "%o has been gunned down by a Grenade Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		MRGL A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 MarineModeSpawn ("GrenadeLauncherMarineGuarding")//,0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
		
	Spawn:
		MRGL A 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfEmpty2//D_StartReloadIfEmpty("PB_DMR")
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRGL DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		
		MRGL AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRGL BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRGL CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRGL DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		MRGL A 1
		goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		MRGL A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		MRGL AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		MRGL AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		MRGL CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRGL DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		
		
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MRGL A 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		
		MRGL AA 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRGL A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRGL A 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		MRGL A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRGL A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRGL A 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		MRGL A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRGL A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		MRGL A 10 A_FaceTarget
		MRGL J 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	
	//Missile:		//MRGL A 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
	Missile2:
	Missile.GrenadeLauncher:
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingAllies(220)>0,"MissileBackup")
		TNT1 A 0 D_AbortAndReloadIfEmpty
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		MRGL AAA random(0,5) //
		TNT1 A 0 {
			D_DepleteWeaponAmmo;
			A_AllyAlertMonsters(500,AMF_TARGETEMITTER);
			A_PlaySound("weapons/firegrenade");
		}
		TNT1 A 0 A_Jump(92,2)
		TNT1 A 0 {
			if (GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Acid");
			}
			if (GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Disintegrate") &&
				GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Frag");
			}
			if (GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Disintegrate")){
				return state("Missile.GrenadeLauncher.Cryo");
			}
			if (GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Disintegrate") &&
				GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Incendiary");
			}
			return state("");
		}
	Missile.GrenadeLauncher.Frag://Explosive
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_FragGrenade")
		//TNT1 A 0 D_DoMarineFireFX("MarineGLFireFrag",0)
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Acid://Disintegrate
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_AcidGrenade")
		//TNT1 A 0 D_DoMarineFireFX("MarineGLFireAcid",0)
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Cryo://Ice
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_CryoGrenade")
		//TNT1 A 0 D_DoMarineFireFX("MarineGLFireCryo",0)
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Incendiary://Fire
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_IncendiaryGrenade")
		//TNT1 A 0 D_DoMarineFireFX("MarineGLFireIncendiary",0)
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.End:
		MRGL A 3 BRIGHT D_DoMarineDelayFireFX("MarineGLFireDelay")
		TNT1 A 0 A_Jump(256,"See")
	StrafeLeft:
		MRGL A 3 A_FaceTarget
		MRGL B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MRGL C 3 A_FaceTarget
		MRGL D 3 ThrustThing(angle*256/360+192, 3, 0, 0)		Goto Missile2
		
	StrafeRight:
		MRGL A 3 A_FaceTarget
		MRGL B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MRGL C 3 A_FaceTarget
		MRGL D 3 ThrustThing(angle*256/360+64, 3, 0, 0)		Goto Missile2
		
	Retreat:
		MRGL A 3 A_FaceTarget
		MRGL B 3 A_Recoil(5)		TNT1 A 0 A_Recoil(5)
		MRGL CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		MRGL E 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		MRGL E 3 A_Pain
		Goto FollowPlayer
	}
}
ACTOR GrenadeLauncherMarineGuarding: Marine_GrenadeLauncher{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		MRGL A 30
		TNT1 A 0 MarineModeSpawn("Marine_GrenadeLauncher")
		Stop
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		MRGL A 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
	See:
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineGrenadeLauncherReload")
		MRGL AAAAAAAAAAAAAAAAAA 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
			
		
	Pain:
		MRGL E 3
		MRGL E 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		MRGL A 3 A_FaceTarget
		MRGL B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MRGL C 3 A_FaceTarget
		MRGL D 3 ThrustThing(angle*256/360+192, 3, 0, 0)		Goto Missile2
		
	StrafeRight:
		MRGL A 3 A_FaceTarget
		MRGL B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MRGL C 3 A_FaceTarget
		MRGL D 3 ThrustThing(angle*256/360+64, 3, 0, 0)		Goto Missile2		
	}
}
