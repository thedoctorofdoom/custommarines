ACTOR Marine_BFG: PBMarine{
	DropItem "CellPack"//"BFGMarineDrop"
	Species "Marines"
	Translation "112:127=[0,256,0]:[0,0,0]"
	PBMarine.MarineWeapon "PB_BFG9000"
	PBMarine.AllyCountedInventory "NumberOfAlliesBFG"
	PBMarine.AllyMapCounter "NumberOfAlliesBFGThisMap"
	Obituary "%o has been gunned down by a BFG Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PLA7 A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 MarineModeSpawn ("BFGMarineGuarding")
		Stop
	Spawn:
		PLA7 A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA7 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		
		PLA7 AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA7 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA7 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		PLA7 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PLA7 A 1
		goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PLA7 A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PLA7 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		PLA7 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PLA7 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA7 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		
		
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	
	Waits:
		PLA7 E 1
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		
		PLA7 EE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA7 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA7 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PLA7 E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		TNT1 A 0 A_MakeNotShootable()
		PLA7 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA7 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PLA7 E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		TNT1 A 0 A_MakeNotShootable()
		PLA7 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PLA7 A 10 A_FaceTarget
		PLA7 I 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	
	//Missile:
		//PLA7 E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		
	Missile2:
	Missile.BFG:
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(500)>2,"Missile.BFG9000")
		Goto Missile.BFG.RapidFire
	Missile.BFG9000:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PLA7 EE 5 A_FaceTarget
		TNT1 A 0 A_ChangeFlag("NOPAIN", 1 )
		TNT1 A 0 A_Stop
		TNT1 A 0 A_JumpIfTargetInLOS(1)
		TNT1 A 0 A_Jump(256,"See")
		PLA7 E 5 BRIGHT A_StartSound("weapons/bfg_chargeloop", CHAN_BODY)
		TNT1 A 0 A_StartSound("weapons/bfg_chargestart", CHAN_5)
		PLA7 EEEEEEEEEEEEEEEEE 1 BRIGHT LIGHT("BARONBALL_X2")
		PLA7 EEEEEEEE 1 BRIGHT LIGHT("BARONBALL_X3") 
		TNT1 A 0 A_AllyAlertMonsters(800,AMF_TARGETEMITTER)
		TNT1 A 0 {
			A_StopSound(CHAN_WEAPON);
			A_StopSound(CHAN_6);
			A_StartSound("bfg/fire_primary", CHAN_WEAPON);
		}
		PLA7 F 4 BRIGHT {
			PBCM_SpawnProjectile("PBMarine_SuperBFGBall",40,0,0,0);
		}
		PLA7 E 8 //BRIGHT
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
		TNT1 A 0 A_Jump(256,"See")
	Missile.BFG.RapidFire:
		TNT1 A 0 {A_MakeShootable();A_ChangeFlag("SOLID", 1);}
		M10K AAA 5 A_FaceTarget
		TNT1 A 0 A_Stop
		TNT1 A 0 A_JumpIfTargetInLOS(2)
		TNT1 A 0 A_Jump(256,"See")
		M10K A 10 {A_ChangeFlag("NOPAIN", 1 );A_PlaySound("10KSTART", 4);}
		M10K AA 10 A_FaceTarget
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		TNT1 A 0 A_MarineRefire(64, "Missile.BFG.RapidFireEnd")
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		M10K A 0 A_JumpIfTargetInLOS(1)		goto Missile.BFG.RapidFireEnd
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
		
		M10K A 0 A_JumpIfTargetInLOS(1)
		goto Missile.BFG.RapidFireEnd
		M10K A 1 BRIGHT A_SpawnProjectile("GreenFlareSpawn",50,0,0,0)
		M10K A 1 BRIGHT {PBCM_SpawnProjectile("PBMarine_BFGSmallSphere",50,1,0,0);A_PlaySound("10KFIRE", 1);}
		M10K A 6 {A_SpawnProjectile("GreenFlareSpawn",50,0,0,0);A_FaceTarget;}
	Missile.BFG.RapidFireEnd:
		TNT1 A 0 A_PlaySound("10KSTOP", 4)
		TNT1 A 0 A_ChangeFlag("NOPAIN", 0 )
		TNT1 A 0 A_Jump(256,"See")
		/*
	Missile3:
		TNT1 A 0 A_StartSound("weapons/bfg_beamstart", CHAN_5)
		016G ABCDEFGHIJKLFGHIJK 1 BRIGHT
		016G L 1 BRIGHT {
			A_StartSound("SUPERBFG", CHAN_AUTO);
			A_StartSound("Weapons/BFSG/Fire", CHAN_AUTO);
			A_ZoomFactor(0.94, ZOOM_INSTANT);
		}
	BeamLoop:
		016G FGHIJKL 1 BRIGHT {
			PB_FireOffset;
			A_FireCustomMissile ("BFG_BeamProjectile", 0, 0, 0, -8, 0,0);
			PB_FireAltBFGRail();  //function defined in BaseWeapon_Function.zsc to replace the rail and the projectilew
			//A_RailAttack(0, 0, 0,"None", "Green", RGF_SILENT || RGF_NOPIERCING || RGF_FULLBRIGHT, 2.0, "NullPuff", 0, 0, 0, 0, 10.0, 1.0, "BFGLightningTrial_Small", -7,0,0);
			A_TakeInventory("PB_Cell", 1);
			
			if(CountInv("PB_Cell") < 1) {
				return state("AltHoldStop");
			}
			return state("");
		}
		TNT1 A 0 {
			A_StartSound("Leech/Fire", CHAN_WEAPON, CHANF_LOOPING);
		}
		TNT1 A 0 A_Refire("BeamLoop")
	AltHoldStop:
		TNT1 A 0 {
			A_StopSound(CHAN_WEAPON);
			A_StartSound("Weapons/BFGG/Explode", CHAN_AUTO);
		}
		016G MNOPQR 1 BRIGHT
		*/
	StrafeLeft:
		PLA7 A 3 A_FaceTarget
		PLA7 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA7 C 3 A_FaceTarget
		PLA7 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PLA7 A 3 A_FaceTarget
		PLA7 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA7 C 3 A_FaceTarget
		PLA7 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2
	Retreat:
		TNT1 A 0
		PLA7 A 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		PLA7 B 3
		TNT1 A 0 A_Recoil(5)
		PLA7 CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PLA7 G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PLA7 G 3 A_Pain
		Goto FollowPlayer
	}
}

ACTOR BFGMarineGuarding: Marine_BFG{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		PLA7 A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 MarineModeSpawn ("Marine_BFG")//,0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		TNT1 A 0 A_SetHealth((random(20,60)*5))
		PLA7 E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		PLA7 EEEEEEEEEEEEEEEEEE 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
	
		
		
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
		
	Pain:
		PLA7 G 3
		PLA7 G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		//TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		PLA7 A 3 A_FaceTarget
		PLA7 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA7 C 3 A_FaceTarget
		PLA7 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PLA7 A 3 A_FaceTarget
		PLA7 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA7 C 3 A_FaceTarget
		PLA7 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}
