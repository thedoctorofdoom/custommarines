ACTOR Marine_M2Plasma: PBMarine{
	DropItem "M2PlasmaMarineDrop"
	Translation "112:127=[128,192,256]:[0,0,0]"
	PBMarine.MarineWeapon "PB_M2Plasma"
	PBMarine.AllyCountedInventory "NumberOfAlliesM2Plasma"
	PBMarine.AllyMapCounter "NumberOfAlliesM2PlasmaThisMap"
	Obituary "%o has been gunned down by an M2 Plasma Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PLA6 A 30
		TNT1 A 0 MarineModeSpawn("M2PlasmaMarineGuarding")
		Stop
		
	Spawn:
		PLA6 A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLA6 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PLA6 AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLA6 BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLA6 CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLA6 DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PLA6 A 1
		Goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PLA6 A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PLA6 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PLA6 CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLA6 DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PLA6 H 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PLA6 HE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA6 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA6 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PLA6 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA6 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PLA6 E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PLA6 H 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PLA6 E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PLA6 A 10 A_FaceTarget
		PLA6 I 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	GiveHealth:
		PLA6 A 10 A_FaceTarget
		PLA6 J 30 A_StartVoiceLine("MRNGI2")
		goto HandOverStimpack
		
	//Missile:
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
	Missile2:
	Missile.M2Plasma:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PLA6 E 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(200,AMF_TARGETEMITTER)
		TNT1 A 0 A_JumpIf(random(0,2) > 1 && CheckTargetSurroundingEnemies(200)>2,"Missile.M2Plasma.Gas")
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,2)){D_DepleteWeaponAmmo("PB_M2Plasma",2);A_PlaySound("m2plasma", CHAN_WEAPON);}}
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HeavyPlasmaBall",40,0,0,0)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_AltHeavyPlasmaBall",40,0,0,0)
		PLA6 E random(1,6) A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,2)){D_DepleteWeaponAmmo("PB_M2Plasma",2);A_PlaySound("m2plasma", CHAN_WEAPON);}}
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HeavyPlasmaBall",40,0,0,0)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_AltHeavyPlasmaBall",40,0,0,0)
		PLA6 E random(1,6) A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,2)){D_DepleteWeaponAmmo("PB_M2Plasma",2);A_PlaySound("m2plasma", CHAN_WEAPON);}}
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HeavyPlasmaBall",40,0,0,0)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_AltHeavyPlasmaBall",40,0,0,0)
		PLA6 E random(1,6) A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,2)){D_DepleteWeaponAmmo("PB_M2Plasma",2);A_PlaySound("m2plasma", CHAN_WEAPON);}}
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HeavyPlasmaBall",40,0,0,0)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_AltHeavyPlasmaBall",40,0,0,0)
		PLA6 E random(1,6) A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,2)){D_DepleteWeaponAmmo("PB_M2Plasma",2);A_PlaySound("m2plasma", CHAN_WEAPON);}}
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HeavyPlasmaBall",40,0,0,0)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_AltHeavyPlasmaBall",40,0,0,0)
		PLA6 E random(1,6) A_FaceTarget
		TNT1 J 0 A_Jump(256,"See")
	Missile.M2Plasma.Gas:
		PLA6 E 1 {if(!D_AbortAndReloadIfEmpty("PB_M2Plasma",null,10)){D_DepleteWeaponAmmo("PB_M2Plasma",10);A_PlaySound("plamersh",1, 1, 1);A_PlaySound("PLSTHRW",3);}}
		PLA6 E 1 A_Jump(256,"Missile.M2Plasma.Gas.LTR","Missile.M2Plasma.Gas.RTL")
		TNT1 J 0 A_Jump(256,"See")
	Missile.M2Plasma.Gas.LTR:
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,8,random(27,33))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,8,random(20,27))
		PLA6 F 1 A_PlaySound("PLSTHRW",4)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,4,random(12,18))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,4,random(5,10))
		PLA6 F 1 A_PlaySound("PLSTHRW",5)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,0,random(-3,3))
		PLA6 F 1 A_PlaySound("PLSTHRW",6)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-4,random(-12,-18))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-4,random(-20,-27))
		PLA6 F 1 A_PlaySound("PLSTHRW",7)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-8,random(-27,-33))
		goto Missile.M2Plasma.Gas.End
	Missile.M2Plasma.Gas.RTL:
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,8,random(-27,-33))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,8,random(-20,-27))
		PLA6 F 1 A_PlaySound("PLSTHRW",4)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,4,random(-12,-18))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,4,random(-5,-10))
		PLA6 F 1 A_PlaySound("PLSTHRW",5)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,0,random(-3,3))
		PLA6 F 1 A_PlaySound("PLSTHRW",6)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-4,random(12,18))
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-4,random(20,27))
		PLA6 F 1 A_PlaySound("PLSTHRW",7)
		PLA6 F 1 BRIGHT PBCM_SpawnProjectile("PBMarine_HotPlasmaGas",40,-8,random(27,33))
		goto Missile.M2Plasma.Gas.End
	Missile.M2Plasma.Gas.End:
		PLA6 F 1 BRIGHT A_StopSound(1)
		PLA6 F 2 A_PlaySound("plameren",2)
		TNT1 J 0 A_Jump(256,"See")
	StrafeLeft:
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
	StrafeRight:
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2	
	Retreat:
		TNT1 A 0
		PLA6 A 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		PLA6 B 3
		TNT1 A 0 A_Recoil(5)
		PLA6 CD 3 A_FaceTarget
		Goto MIssile2
				
				
	Pain:
		PLA6 G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PLA6 G 3 A_Pain
		Goto FollowPlayer

	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PLA6 H 10 A_PlayerScream
		
		PLA6 I 10 A_NoBlocking
		PLA6 J 10 
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineM2Plasma",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PLA6 KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PLA6 N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PLA6 O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineM2Plasma",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PLA6 OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PLA6 U -1
		Stop
	}
}

ACTOR M2PlasmaMarineGuarding: Marine_M2Plasma{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		PLA6 A 30
		TNT1 A 0 MarineModeSpawn("Marine_M2Plasma")
		Stop
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PLA6 E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
	See:
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineM2PlasmaReload")
		PLA6 EEEEEEEEEEHHHHHHHHH 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
			
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		
	Missile2:	
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Super::Missile2+3
	Pain:
		PLA6 G 3
		PLA6 G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		//TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}

