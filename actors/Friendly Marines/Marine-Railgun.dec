ACTOR Marine_Railgun: PBMarine{
	DropItem "RailgunMarineDrop"
	Translation "112:127=[0,0,256]:[0,0,0]"
	PBMarine.MarineWeapon "PB_Railgun"
	PBMarine.AllyCountedInventory "NumberOfAlliesRailgun"
	PBMarine.AllyMapCounter "NumberOfAlliesRailgunThisMap"
	Obituary "%o has been gunned down by a Railgun Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		MRRG A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 MarineModeSpawn ("RailgunMarineGuarding")//,0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
		
	Spawn:
		MRRG A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRRG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		
		MRRG AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRRG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRRG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		MRRG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		
		
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		MRRG A 1
		goto BecomeEnemy24
		
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		MRRG A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		MRRG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		MRRG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		MRRG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRRG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		
		
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MRRG D 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		
		MRRG DA 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRRG A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRRG A 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		MRRG D 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRRG A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRRG A 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		MRRG D 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRRG A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		MRRG A 10 A_FaceTarget
		MRRG A 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	
	//Missile:
		//MRRG A 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		TNT1 A 0 A_JumpIf(random(0,2)>1 && CheckTargetSurroundingAllies(220)<1 && CheckTargetSurroundingEnemies(220)>3,"Missile3")
	Missile2:	
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		MRRG A 5 A_FaceTarget
		TNT1 A 0 D_AbortAndReloadIfEmpty
		TNT1 A 0 A_AllyAlertMonsters(400,AMF_TARGETEMITTER)
		TNT1 A 0 A_PlaySound("RAILF1", CHAN_WEAPON)
		MRRG A 0 A_CustomRailgun(0,40,"none","none",RGF_FULLBRIGHT,0,0,"RailgunPuff2")
		MRRG A 0 BRIGHT D_DepleteWeaponAmmo(null,12)
		MRRG A 0 A_AllySpawnProjectile("PBMarine_RailgunWallPenetrationHitscan", 32)
		MRRG A 0 A_AllySpawnProjectile("PBMarine_GaussSiegeDamageAndPuff",32)
		//MRRG A 0 A_CustomMissile("RailgunLaserBlast1",40)
		MRRG A 2 BRIGHT {A_AllySpawnProjectile("PBMarine_RailProjectile",32,0,0,0);D_DoMarineDelayFireFX("MarineRailgunRecoil");}
		MRRG A 0 A_Jump(256,"See")
	Missile3:
		MRRG A 6 A_FaceTarget
		TNT1 A 0 A_Playsound("CYBRLZR")
		MRRG A 7 A_FaceTarget
		//Charging up animation
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_PlaySound("Weapons/StachanovCharged3")
		TNT1 A 0 A_giveinventory("MarineRailFx",1)//A_CustomRailgun(0, -20, "None", "None", RGF_SILENT || RGF_NOPIERCING || RGF_FULLBRIGHT , 1, 0, "Laser_Red_CyberDemon",0,0,3000,0,1,1.0, "Tracer_Trail_Red_Cyberdemon", 18)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 A 0 A_CustomMissile("RedFlare",66,-21,0,0)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)
		MRRG A 2 A_FaceTarget
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 A 0 A_CustomMissile("RedFlare",66,-21,0,0)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 2 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 3 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 3 A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		MRRG A 3 BRIGHT A_giveinventory("MarineRailFx",1)
		TNT1 AA 0 A_SpawnProjectile("ObeliskTrailSpark",32)
		TNT1 A 0 A_giveinventory("MarineRailFx",1)	
		TNT1 A 0 A_PlaySound("Weapons/StachanovFire")
		MRRG A 18 PBCM_SpawnProjectile("PBMarine_LaserCannon",32)
		MRRG A 0 A_Jump(256,"See")
	
	StrafeLeft:
		MRRG A 3 A_FaceTarget
		MRRG B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MRRG C 3 A_FaceTarget
		MRRG D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		MRRG A 3 A_FaceTarget
		MRRG B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MRRG C 3 A_FaceTarget
		MRRG D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2
		
	Retreat:
		TNT1 A 0
		MRRG A 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		MRRG B 3
		TNT1 A 0 A_Recoil(5)
		MRRG CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		MRRG G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		MRRG G 3 A_Pain
		Goto FollowPlayer
	}
}

ACTOR RailgunMarineGuarding: Marine_Railgun{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		MRRG A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 MarineModeSpawn ("Marine_Railgun")//,0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		TNT1 A 0 A_SetHealth((random(20,60)*5))
		MRRG A 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineRailgunReload")
		MRRG AAAAAAAAAADDDDDDDDD 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
	
		
		
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2			
		
	Pain:
		MRRG G 3
		MRRG G 3 A_Pain
		TNT1 A 0 A_JumpStrafeChance(128)
		//TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
		
	StrafeLeft:
		MRRG A 3 A_FaceTarget
		MRRG B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MRRG C 3 A_FaceTarget
		MRRG D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		MRRG A 3 A_FaceTarget
		MRRG B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MRRG C 3 A_FaceTarget
		MRRG D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2		
	}
}
