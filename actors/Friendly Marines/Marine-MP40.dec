ACTOR Marine_MP40: PBMarine{
	DropItem "MP40MarineDrop"
	PBMarine.AllyCountedInventory "NumberOfAlliesMP40"
	PBMarine.AllyMapCounter "NumberOfAlliesMP40ThisMap"
	Translation "112:127=[64,64,64]:[0,0,0]"
	PBMarine.MarineWeapon "PB_MP40"
	Obituary "%o has been gunned down by an MP40 Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		MR7S A 30
		TNT1 A 0 MarineModeSpawn("MP40MarineGuarding")
		Stop
	Spawn:
		MRMP A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		MRMP DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		MRMP AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MRMP BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MRMP CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		MRMP DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		MRMP A 1
		goto BecomeEnemy24
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		MRMP A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		MRMP AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		MRMP CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		MRMP DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MRMP D 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		MRMP DA 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRMP D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRMP D 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		MRMP A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRMP D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MRMP D 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		MRMP A 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MRMP D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	GiveAmmo:
		MR7S A 10 A_FaceTarget
		TNT1 A 0 A_StartVoiceLine("MRNGI1")
		MR8S CD 15
		goto HandOverAmmo
	//Missile:
		//PLAY E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackMelee")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		TNT1 A 0 A_JumpIf(random(0,2)>1 && CheckTargetSurroundingAllies(220)<1 && CheckTargetSurroundingEnemies(220)>3,"AttackGrenade")
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 A_JumpStrafeChance(128)
	Missile2:
		MRMP A 6 A_FaceTarget
		MRMP A 40 D_DoMarineFireFX("MarineMP40Fire",10)
		TNT1 A 0 A_Jump(256,"See")
	StrafeLeft:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Left
		MRMP A 3 A_FaceTarget
		MRMP B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		MRMP C 3 A_FaceTarget
		MRMP D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	StrafeRight:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Right
		MRMP A 3 A_FaceTarget
		MRMP B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		MRMP C 3 A_FaceTarget
		MRMP D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	Retreat:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Retreat
		MRMP A 3 A_FaceTarget
		MRMP B 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		MRMP CD 3 A_FaceTarget
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	Missile.Left:
		MRMP A 2 A_FaceTarget
		TNT1 A 0 D_DoMarineFireFX("MarineMP40Fire",7)
		MRMP ABCBABCB 3 ThrustThing(angle*256/360+192, random(random(2,3),3), 0, 0)
		TNT1 A 0 A_Jump(256,"See")
	Missile.Right:
		MRMP A 2 A_FaceTarget
		TNT1 A 0 D_DoMarineFireFX("MarineMP40Fire",7)
		MRMP ABCBABCB 3 ThrustThing(angle*256/360+64, random(random(2,3),3), 0, 0)
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat:
		TNT1 A 0 D_DoMarineFireFX("MarineMP40Fire",7)
		MRMP ABCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Pain.Kick:
		MRMP E 2 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		Goto FollowPlayer
	Pain:
		MRMP E 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		MRMP E 3 A_Pain
		Goto FollowPlayer
	}
}

ACTOR MP40MarineGuarding: Marine_MP40{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		MRMP A 30
		TNT1 A 0 MarineModeSpawn("Marine_MP40")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		MRMP D 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineMP40Reload")
		MRMP AAAAAAAAAAAAAAAAAAAA 1 A_AllyChaseSee
		TNT1 A 0 A_ClearTarget
		Loop
		
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		MRMP A 6 A_FaceTarget
		goto Missile2
	Pain.Kick:
		MRMP A 2 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		TNT1 A 0 A_Jump(256,"See")
		
	Pain:
		MRMP G 3
		MRMP G 3 A_Pain
		TNT1 A 0 A_Jump(128, "Missile.Left", "Missile.Right")
		TNT1 A 0 A_Jump(256,"See")
	}
}


