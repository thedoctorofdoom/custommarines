ACTOR EliteMarine_Rifle: EliteMarine_Base{
	Health 200
	Speed 10
	DropItem "RifleUpgrade"
	PBMarine.AllyCountedInventory "NumberOfAlliesEliteRifle"
	PBMarine.AllyMapCounter "NumberOfAlliesEliteRifleThisMap"
	PBMarine.MarineWeapon "PB_DMR"
	Translation "112:122=96:111", "123:127=5:8"
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		MR7S A 30
		TNT1 A 0 MarineModeSpawn("EliteRifleMarineGuarding")
		Stop
	Spawn:
		PLAY A 1 NODELAY A_Look
		Goto See
	See:
		TNT1 A 0 A_JumpIfInventory("ZombiemanFatality3", 1, "FatalityZombieman")
		TNT1 A 0 A_JumpIfInventory("ImpFatality3", 1, "FatalityImp")
		TNT1 A 0 A_JumpIfInventory("SergeantFatality", 1, "FatalitySergeant")
		TNT1 A 0 A_JumpIfInventory("RevenantFatality", 1, "FatalityRevenant")
		NULL A 0 A_JumpIfInventory("ComandoFatality", 1, "FatalityComando")
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineDMRReload")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PLAY AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		Goto See
	BecomeEnemy23:
		PLAY A 1
		goto BecomeEnemy24
	FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PLAY A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PLAY AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MARN D 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, 2)
		TNT1 A 0 A_ClearTarget
		Goto See
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		MARN DE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MARN D 8 A_Stop
		
		MARN E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MARN D 8 A_Stop
		
		MARN E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	GiveAmmo:
		MR7S A 10 A_FaceTarget
		MR8S C 0 
		MR8S CD 15
		goto HandOverAmmo
	Missile:
		//PLAY E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "CheckRetreat")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "CheckRetreat")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsABaronOfHell", 1, "CheckRetreat")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMancubus", 1, "CheckRetreat")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackMelee")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		
		TNT1 A 0 A_PlaySound("weapons/hdmr/fir/up", CHAN_WEAPON)
		TNT1 A 0 A_JumpIf(random(0,2)>1 && CheckTargetSurroundingAllies(220)<1 && CheckTargetSurroundingEnemies(220)>3,"AttackGrenade")
		TNT1 A 0 A_Jump(128, "MissileLeft", "MissileRight")
		PLAY E 6 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		PLAY F 1 BRIGHT  {if(!D_AbortAndReloadIfEmpty){A_CustomMissile("MarineMuzzle1", 34);A_PlaySound("weapons/hdmr/fire");D_DepleteWeaponAmmo;PBCM_SpawnProjectile("PBMarine_762x51mm", 40, 0, 0, 0);A_SpawnItem("RifleCaseSpawn", 0, 30,0);}}
		PLAY E 2 A_FaceTarget
		PLAY F 1 BRIGHT  {if(!D_AbortAndReloadIfEmpty){A_CustomMissile("MarineMuzzle1", 34);A_PlaySound("weapons/hdmr/fire");D_DepleteWeaponAmmo;PBCM_SpawnProjectile("PBMarine_762x51mm", 40, 0, 0, 0);A_SpawnItem("RifleCaseSpawn", 0, 30,0);}}
