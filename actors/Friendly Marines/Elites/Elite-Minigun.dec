		PL42 F 1 BRIGHT {A_PlaySound("weapons/minigunfire2", 1);PBCM_SpawnProjectile("PBMarine_556x45mmAP", 32, 0, random(-8, 8), 1, random(-3, 3));A_SpawnItem ("RifleCaseSpawn", 0, 30,0);}
