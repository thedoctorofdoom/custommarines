		PL42 F 1 BRIGHT {A_PlaySound("weapons/minigunfire2", 1);PBCM_SpawnProjectile("PBMarine_556x45mmAP", 32, 0, random(-8, 8), 1, random(-3, 3));A_SpawnItem ("RifleCaseSpawn", 0, 30,0);}
		PL42 E 1 A_FaceTarget
		//TNT1 A 0 A_LOOKEX(LOF_NOSOUNDCHECK,0, 1024, 0, 0, "FIRECHECK")
		TNT1 A 0 A_JumpIfCloser(500,2)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_CPosREfire
		Goto Missile2+1
	Missile3:
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		PL42 E 12 A_StartSound("CHAINSTA", CHAN_AUTO)
	Missile3Continue:
		PL42 E 0 {A_FaceTarget;A_StartSound("weapons/minigunfire", 1, CHANF_LOOP);A_AllyAlertMonsters(500,AMF_TARGETEMITTER);}
		PL42 EFEFEFEFEFEF 2 BRIGHT {A_FaceTarget;PBCM_SpawnProjectile("PBMarine_556x45mmAP", 32, 0, random(-8, 8), 1, random(-3, 3));A_SpawnItem ("RifleCaseSpawn", 0, 30,0);}
		TNT1 A 0 A_JumpIfCloser(500,3)
		PL42 E 0 A_StopSound(1)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_MonsterRefire(40, "Missile3Finish")
		Goto Missile3Continue
	Missile3Finish:
		PL42 E 0 A_StopSound(1)
		Goto See
		
	StrafeLeft:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
		
	StrafeRight:
		PL42 A 3 A_FaceTarget
		PL42 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PL42 C 3 A_FaceTarget
		PL42 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2
	Retreat:
		TNT1 A 0
		PL42 A 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		PL42 B 3
		TNT1 A 0 A_Recoil(5)
		PL42 CD 3 A_FaceTarget
		Goto MIssile2
	Pain:
		TNT1 A 0 A_StopSound(1)
		PL42 G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PL42 G 3 A_Pain
		Goto FollowPlayer

	Death:
