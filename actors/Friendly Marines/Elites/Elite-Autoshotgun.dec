ACTOR EliteMarine_AutoShotgun: EliteMarine_Base{
	DropItem "AutoShotgunMarineDrop"
	DropItem "PB_GrenadeAmmo" 5
	Health 250
	PBMarine.MarineWeapon "PB_AutoShotgun"
	Translation "112:122=96:111", "123:127=5:8"
	PBMarine.AllyCountedInventory "NumberOfAlliesEliteAutoshotgun"
	PBMarine.AllyMapCounter "NumberOfAlliesEliteAutoshotgunThisMap"
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PASG A 30
		TNT1 A 0 MarineModeSpawn("EliteAutoShotgunMarineGuarding")
		Stop
	Spawn:
		PASG A 1 NODELAY A_Look
		Goto See
	See:
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineASGReload")
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PASG AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		Goto See
	BecomeEnemy23:
		PASG A 1
		goto BecomeEnemy24
	FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PASG A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PASG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PASG E 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, 2)
		TNT1 A 0 A_ClearTarget
		Goto See
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PASG EE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PASG E 8 A_Stop
		
		PASG E 8 A_Stop
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PASG E 8 A_Stop
		
		PASG E 8 A_Stop
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PASG A 10 A_FaceTarget
		PASG X 30
		goto HandOverAmmo
	GiveHealth:
		PASG A 10 A_FaceTarget
		PASG Y 30
		goto HandOverStimpack
	
	Missile:
		//PASG E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "Missile2")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "Missile2")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsABaronOfHell", 1, "Missile2")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMancubus", 1, "Missile2")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPLayer")//
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		
	Missile2:	
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 6 A_FaceTarget
		Goto See
	StrafeLeft:
		PASG A 3 A_FaceTarget
		PASG B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PASG C 3 A_FaceTarget
		PASG D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		Goto Missile2
	StrafeRight:
		PASG A 3 A_FaceTarget
		PASG B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PASG C 3 A_FaceTarget
		PASG D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		Goto Missile2
	Retreat:
		TNT1 A 0
		PASG D 3 A_FaceTarget
		TNT1 A 0 A_Recoil(5)
		PASG C 3
		TNT1 A 0 A_Recoil(5)
		PASG BA 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PASG G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PASG G 3 A_Pain
		Goto FollowPlayer
	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PASG H 10 A_PlayerScream
		
		PASG I 10 A_NoBlocking
		PASG J 10 
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PASG KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PASG N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PASG O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PASG OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PASG U -1
		Stop
	}
}

ACTOR EliteAutoShotgunMarineGuarding: EliteMarine_AutoShotgun
{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States
	{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PASG A 30
		TNT1 A 0 MarineModeSpawn("EliteMarine_AutoShotgun")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PASG E 1 A_Look
		Goto See
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineASGReload")
		PASG EEEEEEEEEEEEEEEE 1 A_AllyChaseGuard
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_ClearTarget
		Loop
		
	Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "Missile2")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "Missile2")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		
	Missile2:	
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 3 BRIGHT
		PASG E 5 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_AutoShotgun","MarineASGReloadDrum")){D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32);PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}}
