		MAR6 A 4 {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){A_StartSound("HRFire", CHAN_WEAPON, CHANF_OVERLAP);D_DepleteWeaponAmmo;PBCM_SpawnProjectile("PBMarine_HellBullet",40,0,0,0);}}
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
