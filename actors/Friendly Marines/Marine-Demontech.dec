		TNT1 A 0 {
			if(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") || GetTargetDamageFactor("Disintegrate") == GetTargetDamageFactor("Fire")){
				D_DoMarineFireFX("MarineDemonTechFire2",7);
			}else{
				D_DoMarineFireFX("MarineDemonTechFire",7);
			}
		}
		PLA6 BCBABCB 3 ThrustThing(angle*256/360+64, random(random(2,3),3), 0, 0)
