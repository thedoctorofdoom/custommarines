	StrafeLeft:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Left
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	StrafeRight:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Right
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PLA6 C 3 A_FaceTarget
		PLA6 D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	Retreat:
		TNT1 D 0 A_JumpIfCannotFire(1)
		goto Missile.Retreat
		PLA6 A 3 A_FaceTarget
		PLA6 B 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		PLA6 CD 3 A_FaceTarget
		TNT1 D 0 A_JumpIfCannotFire("See")
		Goto Missile2
	Missile.Left:
	Missile.Left.Demontech:
		MARN A 3 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(1000,AMF_TARGETEMITTER)
		TNT1 A 0 {
			if(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") || GetTargetDamageFactor("Disintegrate") == GetTargetDamageFactor("Fire")){
				D_DoMarineFireFX("MarineDemonTechFire2",7);
			}else{
				D_DoMarineFireFX("MarineDemonTechFire",7);
			}
		}
		PLA6 BCBABCB 3 ThrustThing(angle*256/360+192, random(random(2,3),3), 0, 0)
		TNT1 A 0 A_Jump(256,"See")
		
		//TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire"),"Missile.Left.Demontech.Caustic")
	Missile.Left.Demontech.Inferno:
		TNT1 A 0 ThrustThing(angle*256/360+192, 3, 0, 0)
		MAR6 B 4 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty){A_StartSound("HRFire", CHAN_WEAPON, CHANF_OVERLAP);D_DepleteWeaponAmmo;PBCM_SpawnProjectile("PBMarine_HellBullet",40,0,0,0);}}
