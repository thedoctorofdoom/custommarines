		PLA6 A 3 A_FaceTarget
		TNT1 A 0 {
			if(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire")){
				D_DoMarineFireFX("MarineDemonTechFire2",7);
			}else{
				D_DoMarineFireFX("MarineDemonTechFire",7);
			}
		}
		PLA6 BCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(256,"See")
		*/
		/*
		TNT1 A 0 D_DoMarineFireFX("MarineDemonTechFire",8)
		PLA6 BCBABCBA 3 ThrustThing(angle*256/360+192, random(random(2,3),3), 0, 0)
		*/
