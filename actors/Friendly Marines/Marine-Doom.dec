ACTOR Marine_Doom: PBMarine{
	Dropitem "DoomMarineDrop"
	PBMarine.AllyCountedInventory "NumberOfAlliesMarine"
	PBMarine.AllyMapCounter "NumberOfAlliesMarineThisMap"
	Obituary "%o has been gunned down by a Weapons Specialist Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		MR7S A 30
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx ("DoomMarineGuarding",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
	Spawn:
		PLAY A 1 nodelay A_Look
		TNT1 J 0 A_Jump(256,"See")
	See:
		PLAY A 0 {A_StopSound(CHAN_BODY);if(random(0,1)>0){D_StartReloadIfEmpty;}}
		goto Super::See+1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PLAY AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PLAY DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PLAY A 1
		Goto BecomeEnemy24
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PLAY A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PLAY AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PLAY CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PLAY DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		MARN D 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		MARN DE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MARN D 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		MARN E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		MARN D 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		MARN E 8 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		MARN D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		MARN D 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
		
	GiveAmmo:
		MR7S A 10 A_FaceTarget
		MR8S C 15 A_StartVoiceLine("MRNGI1")
		MR8S D 15
		goto HandOverAmmo
	
	Missile2:
		TNT1 A 0 A_Jump(166,2)
		TNT1 A 0 A_JumpStrafe
		TNT1 A 0 A_Jump(10, "MissileRandom")
		TNT1 A 0 A_CheckFlag("BOSS","MissileSuperWeapon",AAPTR_TARGET)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsACyberdemon", 1, "MissileSuperWeapon")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMastermind", 1, "MissileSuperWeapon")
		TNT1 A 0 A_CheckSpecies("MissileHeavy","HellNoble",AAPTR_TARGET)
		TNT1 A 0 A_CheckFlag("NOGRAVITY","MissileAir",AAPTR_TARGET)
		TNT1 A 0 A_CheckFlag("FLOAT","MissileAir",AAPTR_TARGET)
		TNT1 A 0 A_CheckSpecies("MissileHeavy","Mancubus",AAPTR_TARGET)
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(300) > 3,"MissileExplosive")
		TNT1 A 0 A_JumpIfCloser(random(200,300),"MissileCQC")
		TNT1 A 0 A_JumpIfCloser(random(400,600),"MissileMedium")
		goto MissileFar
	MissileRandom:
		TNT1 A 0 A_Jump(256,random(1,19))
		TNT1 A 0 A_Jump(256,"Missile.Rifle")
		TNT1 A 0 A_Jump(256,"Missile.Carbine")
		TNT1 A 0 A_Jump(256,"Missile.SMG")
		TNT1 A 0 A_Jump(256,"Missile.MP40")
		TNT1 A 0 A_Jump(256,"Missile.Minigun")
		TNT1 A 0 A_Jump(256,"Missile.Nailgun")
		TNT1 A 0 A_Jump(256,"Missile.Shotgun")
		TNT1 A 0 A_Jump(256,"Missile.Rocket")
		TNT1 A 0 A_Jump(256,"Missile.GrenadeLauncher")
		TNT1 A 0 A_Jump(256,"Missile.Railgun")
		TNT1 A 0 A_Jump(256,"Missile.Plasma")
		TNT1 A 0 A_Jump(256,"Missile.M2Plasma") 
		TNT1 A 0 A_Jump(256,"Missile.PulseCannon")
		TNT1 A 0 A_Jump(256,"Missile.HML")
		TNT1 A 0 A_Jump(256,"Missile.Demontech")
		TNT1 A 0 A_Jump(256,"Missile.FlameThrower")
		TNT1 A 0 A_Jump(256,"Missile.SuperShotgun")
		TNT1 A 0 A_Jump(256,"Missile.AutoShotgun")
		TNT1 A 0 A_Jump(256,"Missile.BFG9000")
		goto Missile2
	MissileCQC:
		//TNT1 A 0 A_JumpIf(!GetCVAR("pb_explosivemarines"),3)
		//TNT1 A 0 A_Jump(128,2)
		//TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(300) > 3,"MissileExplosive")
		TNT1 A 0 A_Jump(51,"Missile.MP40")
		TNT1 A 0 A_Jump(256,"Missile.SMG","Missile.SuperShotgun","Missile.AutoShotgun")
	MissileMedium:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_Jump(256,"Missile.Shotgun","Missile.AutoShotgun","Missile.Rifle","Missile.Carbine","Missile.HML")
		TNT1 A 0 A_Jump(256,"Missile.Plasma","Missile.Demontech","Missile.M2Plasma","Missile.PulseCannon","Missile.FlameThrower")
	MissileFar:
		TNT1 A 0 A_Jump(256,"Missile.Railgun")
	MissileAir:
		TNT1 A 0 A_Jump(256,"Missile.Rocket","Missile.Railgun","Missile.HML")
	MissileExplosive:
		TNT1 A 0 A_Jump(128,2)
		TNT1 A 0 A_JumpIfCloser(600, "Missile.GrenadeLauncher")
		TNT1 A 0 A_Jump(256,"Missile.Rocket","Missile.FlameThrower")
	MissileHeavy:
		TNT1 A 0 A_Jump(40,"MissileSuperWeapon")
		TNT1 A 0 A_Jump(256,"Missile.Minigun","Missile.Nailgun","Missile.Rocket","Missile.GrenadeLauncher")
	MissileSuperWeapon:
		TNT1 A 0 A_Jump(256,"Missile.BFG9000")
		TNT1 A 0 A_Jump(256,"Missile10K","Missile.BFG9000")
	Missile.Rifle:
		PLAY E 6 A_FaceTarget
		TNT1 A 0 A_JumpStrafeChance(128)
		PLAY E 6 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(1000,AMF_TARGETEMITTER)
		PLAY F 3 D_DoMarineFireFX("MarineRifleFire",3)
		PLAY EFEFE 3
		TNT1 A 0 A_JumpIf(speed > 0,"See")
		TNT1 A 0 A_MarineRefire(40, "See")
		goto Missile.Rifle+4
	Missile.Deagle:
		PLA2 E 1 A_FaceTarget
	Missile.Deagle.Loop:
		PLA2 F 3 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Deagle")){A_PlaySound("weapons/deagle/fire", 1);D_DepleteWeaponAmmo("PB_Deagle");PBCM_SpawnProjectile("PBMarine_50AE", 32, 0, frandom(-0.1,0.1), 0, frandom(-0.1,0.1));PB_SpawnCasing("EmptyBrassDeagle",26,0,38,-frandom(1, 2),Frandom(2,6),Frandom(3,6));}}
		PLA2 E random(4,7) A_FaceTarget
		TNT1 A 0 A_MarineRefire(92, "See")
		PLA3 E 0 A_Jump(256,"Missile.Deagle.Loop")
	Missile.SMG:
		MRMP A 6 {A_StartSound("weapons/smg_up",CHAN_AUTO);A_FaceTarget;}
		MRMP A 30 D_DoMarineFireFX("MarineSMGFire",10)
		TNT1 J 0 A_Jump(256,"See")
	Missile.MP40:
		MRMP A 4 {A_StartSound("weapons/MP40_up",CHAN_AUTO);A_FaceTarget;}
		MRMP A 40 D_DoMarineFireFX("MarineMP40Fire",10)
		TNT1 J 0 A_Jump(256,"See")
	Missile.Carbine:
		TNT1 A 0 A_PlaySound("CLIPIN",CHAN_AUTO)
		TNT1 A 0 A_JumpIfCloser(800,1)
		goto Missile.CarbineBurst
		TNT1 A 0 D_DoMarineFireFX("MarineCarbineFire",8)
		PLAY FEEFEEFEEFEEFEEFEEFEEFEE 1
		//PLAY FEFEFEFE 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Carbine")){D_DepleteWeaponAmmo("PB_Carbine");A_CustomMissile("PBMarineMuzzle1",34);A_PlaySound("Weapons/Carbine/Fire");PB_SpawnCasing("EmptyBrass",32,-2,30,Frandom(4,7),Frandom(6,9),Frandom(0,5));PBCM_SpawnProjectile("PBMarine_556x45mm", 40, 0, random(-1,1), 0,random(-1,1));}}
		TNT1 J 0 A_Jump(256,"See")
	Missile.CarbineBurst:
		TNT1 A 0 D_DoMarineFireFX("MarineCarbineBurst",3)
		PLAY FEFEFE 1
		TNT1 J 0 A_Jump(256,"See")
	Missile.LMG:
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 A_JumpStrafeChance(128)
		TNT1 A 0 A_JumpIfCloser(1170,2)
		TNT1 A 0 A_Jump(256,2)
		PLAY E 6 A_FaceTarget
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"Missile.LMG.MicroMissile")
		TNT1 A 0 D_DoMarineFireFX("MarineLMGFire",10)
		PLAY FEFEFEFEFEFEFEFEFEFE 2
		TNT1 A 0 A_Jump(256,"See")
	Missile.LMG.MicroMissile:
		TNT1 A 0 D_DoMarineFireFX("MarineLMGFireMM",8)
		PLAY FFEEEFFEEEFFEEEFFEEEFFEEEFFEEEFFEEEFFEEE 1 
		TNT1 A 0 A_Jump(256,"See")
	Missile.Minigun:
		TNT1 A 0 A_PlaySound("CHGNPKUP",CHAN_AUTO)
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 A_JumpIfCloser(500, "Missile.Minigun.B")
		PL42 E 2 A_FaceTarget
	Missile.Minigun.Continue:
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPLayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire",18)
		PL42 FEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEEFEE 1
		TNT1 A 0 A_MarineRefire(40,"Missile.Minigun.Continue")
		Goto Missile.Minigun.Continue
		TNT1 A 0 A_JumpIfCloser(500,2)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_CPosREfire
		TNT1 J 0 A_Jump(256,"Missile.Minigun.Continue")
	Missile.Minigun.B:
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPLayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		PL42 E 12 A_StartSound("CHAINSTA", CHAN_AUTO)
	Missile.Minigun.B.Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineMinigunFire2",12)
		PL42 FEFEFEFEFEFEFEFEFEFEFEFE 1 BRIGHT
		TNT1 A 0 A_JumpIfCloser(500,3)
		PL42 E 0 A_StopSound(1)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_MarineRefire(40, "Missile.Minigun.B.Finish")
		Goto Missile.Minigun.B.Continue
	Missile.Minigun.B.Finish:
		PL42 E 0 A_StopSound(1)
		TNT1 J 0 A_Jump(256,"See")
	Missile.Nailgun:
		TNT1 A 0 A_JumpIfHealthLower(360,2,AAPTR_TARGET)
		TNT1 A 0 A_JumpIfCloser(600,1)
		goto Missile.Nailgun.Javelin
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(220)>1,"Missile.Nailgun.Alt")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPLayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_PlaySound("weapons/chagan/start")
		PL42 EEE 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
	Missile.Nailgun.Continue:
		TNT1 A 0 D_DoMarineFireFX("MarineNailgunFire",4)
		PL42 FEEFEEFEEFEE 1 
		TNT1 A 0 A_JumpIfCloser(500,2)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_MarineRefire(40, "Missile.Nailgun.Done")
		Goto Missile.Nailgun.Continue
	Missile.Nailgun.Alt:
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Nailgun", null, 20)
		PL42 E 4 A_StartSound("weapons/nailgun/altcharge", CHAN_AUTO)
		PL42 E 18 A_StartSound("weapons/nailgun/inspect4", CHAN_AUTO)
		TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnGravityProjectile("PBMarine_MGNail", 34, 2, Random(-10, 10), 0, Random(-10, 10))
		PL42 F 3 BRIGHT {D_DoMarineDelayFireFX("MarineNailgunAltfireSequence");D_DepleteWeaponAmmo("PB_Nailgun",20);A_FaceTarget;A_StartSound("weapons/nailgun/altfire", CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);}
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Javelin:
		TNT1 A 0 A_Jump(128,"Missile.Nailgun.Javelin.Alt")
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Nailgun", null, 20)
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun", null, 20)){A_FaceTarget;D_DoMarineDelayFireFX("MarineNailgunJavelinSequence");A_StartSound("weapons/nailgun/javelinfire",CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo("PB_Nailgun",20);A_SpawnGravityProjectile("PBMarine_JavelinProjectile", 34, 2, 0, 0, 0);}}
		PL42 E 2 
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Javelin.Alt:
		PL42 E 33 {if(!D_AbortAndReloadIfEmpty("PB_Nailgun", null, 20)){A_StartSound("weapons/nailgun/javelincharge", CHAN_WEAPON);}}
		PL42 F 1 BRIGHT {if(!D_AbortAndReloadIfEmpty("PB_Nailgun", null, 20)){A_FaceTarget;D_DoMarineDelayFireFX("MarineNailgunJavelinSequence");A_StartSound("weapons/nailgun/javelinfire",CHAN_AUTO);A_CustomMissile("OrangeLensFlareAltFast", 34, 10, 15, 0);D_DepleteWeaponAmmo("PB_Nailgun",20);A_SpawnGravityProjectile("PBMarine_JavelinProjectile_Hot", 34, 2, 0, 0, 0);}}
		PL42 E 2 
		TNT1 A 0 A_Jump(256,"See")
	Missile.Nailgun.Done:
		TNT1 A 0 A_PlaySound("weapons/nailgun/fireStop",CHAN_BODY, 1.0, False)
		TNT1 A 0 A_Jump(256,"See")
	Missile.MG42:
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		PL42 E 3 A_PlaySoundEx("IronSights", "Auto")
	Missile.MG42Continue:
		PL42 EFEFEFEFEFEFEFEFEFEFEFEF 2 BRIGHT {A_FaceTarget;A_StartSound("MG42FIR", 1);PBCM_SpawnProjectile("PBMarine_792x57mm", 32, 0, random(-8, 8), 1, random(-3, 3));PB_SpawnCasing("MG42Casing", 16, -3, 33,frandom(3, 8),frandom(-2,2),frandom(-6,-3));}
		TNT1 A 0 A_JumpIfCloser(500,2)
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_MarineRefire(40, "See")
		Goto Missile.MG42Continue
	Missile.Shotgun:
		PLA3 E 6 A_FaceTarget
		TNT1 A 0 A_JumpIf(GetPBTier < 2,2)
		TNT1 A 0 A_JumpIfCloser(400, 1)
		goto Missile.Shotgun.Slug
	Missile.Shotgun.Shot:
		TNT1 A 0 A_Jump(128,"Missile.Shotgun.Shot.B")
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Shotgun")
		TNT1 AAAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet", 32, 0, random(-6, 6), 1, random(-3, 3))
