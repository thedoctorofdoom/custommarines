			A_StopSound(CHAN_WEAPON);
			A_StopSound(CHAN_6);
			A_StartSound("bfg/fire_primary", CHAN_WEAPON);
		}
		PLA7 F 4 BRIGHT A_CustomMissile("PBMarine_SuperBFGBall",40,0,0,0)
