	Missile.PulseCannon:
		PSTN E 5 {A_FaceTarget;A_MakeShootable();A_ChangeFlag("SOLID", 1);}
		TNT1 A 0 A_AllyAlertMonsters(200,AMF_TARGETEMITTER)
