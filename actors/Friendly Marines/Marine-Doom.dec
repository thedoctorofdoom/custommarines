		MARN BCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.SMG:
		MRMP A 0 {A_StartSound("weapons/smg_up",CHAN_AUTO);A_FaceTarget;}
		TNT1 A 0 D_DoMarineFireFX("MarineSMGFire",8)
		MRMP ABCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.Plasma:
		MRMP A 0 {A_StartSound("PLSDRAW",CHAN_AUTO);A_FaceTarget;}
		TNT1 A 0 D_DoMarineFireFX("MarinePlasmaFire",7)
		MAR6 ABCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 J 0 A_Jump(256,"See")
	Missile.Retreat.PulseCannon:
		PSTN A 0 D_DoMarineFireFX("MarinePulseFire",7)
		PSTN ABCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.Flamethrower:
		TNT1 A 0 A_JumpIf(GetTargetDamageFactor("Disintegrate") < GetTargetDamageFactor("Fire"),"Missile.Retreat.Flamethrower.Acid")
	Missile.Retreat.Flamethrower.Fire:
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		MMFC A 3 {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",3);PBCM_SpawnProjectile("PBMarine_FlamethrowerMissile",32,0,0,0);A_CustomMissile("ShotgunParticles",32,0,random(-11,11),0,random(-15,-2));}}
		TNT1 A 0 {A_StartSound("weapons/flamethrower/stop", CHAN_AUTO, CHANF_OVERLAP );A_StopSound(CHAN_BODY);}
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.Flamethrower.Acid:
		TNT1 A 0 A_StartSound("weapons/flamethrower/loop", CHAN_BODY, CHANF_LOOPING)
		MMFC A 3 {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC CBA 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC BC 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 A_Recoil(5)
		MMFC B 3 BRIGHT {A_FaceTarget;if(!D_AbortAndReloadIfEmpty("PB_Flamethrower")){D_DepleteWeaponAmmo("PB_Flamethrower",2);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);A_SpawnGravityProjectile("PBMarine_NukageStreamMissile",32,0,0,0);}}
		TNT1 A 0 {A_StopSound(CHAN_5);A_StopSound(CHAN_BODY);A_StartSound("weapons/flamethrower/acidstop", CHAN_BODY );}
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.Demontech:
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		PLA6 A 3 A_FaceTarget
		TNT1 A 0 {
			if(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") || GetTargetDamageFactor("Disintegrate") == GetTargetDamageFactor("Fire")){
				D_DoMarineFireFX("MarineDemonTechFire2",7);
			}else{
				D_DoMarineFireFX("MarineDemonTechFire",7);
			}
		}
		PLA6 BCBABCB 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(256,"See")
	Missile.Retreat.LMG:
		MARN A 3 A_FaceTarget
		PLAY F 0 D_DoMarineFireFX("MarineLMGFire",8)
		MARN BCBABCBA 3 A_Recoil(20/7)
		TNT1 A 0 A_Jump(128, "Missile.Right", "Missile.Left")
		TNT1 A 0 A_Jump(256,"See")
	}
}

ACTOR DoomMarineGuarding: Marine_Doom{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+DONTSPLASH
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		MR7S A 30
		TNT1 A 0 A_ChangeFLag("NOBLOCKMAP", 1)
		TNT1 A 0 A_SpawnItemEx ("Marine_Doom",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		Stop
		
	Spawn:
		MARN D 1 NODELAY A_Look
		TNT1 J 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty
		MARN DDDDDDDDDD 1 A_AllyChaseGuard
		TNT1 A 0 A_ClearTarget
		Loop
	
		
	//Missile:
		//PLAY E 1
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		//TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
		goto Missile2
	}
}