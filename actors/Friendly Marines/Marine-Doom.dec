		TNT1 A 0 A_ChangeFlag("NOPAIN", 0 )
		TNT1 J 0 A_Jump(256,"See")
	Missile.HML:
		MHML B 5 {A_MakeShootable();A_ChangeFlag("SOLID", 1);A_FaceTarget;}
