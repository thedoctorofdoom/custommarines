	Missile.AutoShotgun:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_AutoShotgun")
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, random(-6, 6), 1, random(-3, 3))
		PLA3 K 0 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PASG F 3 BRIGHT A_PlaySound("weapons/AutoShotgun", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_AutoShotgun")
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, random(-6, 6), 1, random(-3, 3))
		PLA3 K 0 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PASG F 3 BRIGHT A_PlaySound("weapons/AutoShotgun", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_AutoShotgun")
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, random(-6, 6), 1, random(-3, 3))
		PLA3 K 0 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PASG F 3 BRIGHT A_PlaySound("weapons/AutoShotgun", 1)
		PASG E 5 A_FaceTarget
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_AutoShotgun")
		TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, random(-6, 6), 1, random(-3, 3))
		PLA3 K 0 A_SpawnItem("ShotCaseSpawn", 0, 30,0)
		PASG F 3 BRIGHT A_PlaySound("weapons/AutoShotgun", 1)
		PASG E 6 A_FaceTarget
		TNT1 J 0 A_Jump(256,"See")
	Missile.SuperShotgun:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfHealthLower(181,"Missile.SuperShotgun2",AAPTR_TARGET)
		TNT1 A 0 A_Jump(96,"Missile.SuperShotgun2")
		PLA9 E 6 A_FaceTarget
		TNT1 A 0 {if(!D_AbortAndReloadIfEmpty("PB_SSG")){
		D_DepleteWeaponAmmo("PB_SSG",2);
		PBCM_SpawnProjectile("PBMarine_10GAPellet_LP", 32, 0, 0, 1, 0);}}
		TNT1 AAAAAAAAAAAAAAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_10GAPellet", 32, 0, random(-9, 9), 1, random(-5, 5))
		PLA9 F 3 BRIGHT A_PlaySound("SSHFIRE", 1)
		PLA9 E 11
		goto Reload.SuperShotgun
	Reload.SuperShotgun:
		TNT1 A 0 D_DoMarineReloadFX("PB_SSG")
		TNT1 A 0 A_JumpIf(speed == 0,2)
		TNT1 A 0 A_Jump(256,"See")
		PLA9 E 26
		TNT1 A 0 A_Jump(256,"See")
	Missile.SuperShotgun2:
		PLA9 E 6 A_FaceTarget
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_SSG")
		TNT1 AAAAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_10GAPellet", 32, 0, random(-7, 7), 1, random(-6, 6))
		PLA9 F 3 BRIGHT {D_DepleteWeaponAmmo("PB_SSG");A_PlaySoundEx("weapons/shh2", "Weapon");}
		PLA9 E 5 
		TNT1 A 0 A_MarineRefire(92, "See")
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_SSG")
		TNT1 AAAAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_10GAPellet", 32, 0, random(-7, 7), 1, random(-6, 6))
		PLA9 F 3 BRIGHT {D_DepleteWeaponAmmo("PB_SSG");A_PlaySoundEx("weapons/shh2", "Weapon");}
		PLA9 E 5 
		goto Reload.SuperShotgun
	Missile.Rocket:
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingAllies(170)>0,"MissileBackup")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PL5S EEE 5 A_FaceTarget
		TNT1 A 0 {A_PlaySound("DSRFIRE");D_DepleteWeaponAmmo;A_AllyAlertMonsters(500,AMF_TARGETEMITTER);}
		TNT1 A 0 A_Jump(92,2)
		TNT1 A 0 A_CheckFlag("NOGRAVITY","Missile.Rocket.Homing")
	Missile.Rocket.Normal:
		PL5S E 2 BRIGHT PBCM_SpawnProjectile("PBMarine_Rocket",50,0,0,0)
		PL5S EEE 5 A_FaceTarget
		TNT1 A 0 A_Jump(256,"See")
	Missile.Rocket.Homing:
		PL5S E 2 BRIGHT PBCM_SpawnProjectile("PBMarine_HomingRocket_1",50,0,0,0)
		PL5S EEE 5 A_FaceTarget
		TNT1 A 0 A_Jump(256,"See")
	Missile.GrenadeLauncher:
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingAllies(220)>0,"MissileBackup")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		MRGL AAA 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		MRGL A 2 BRIGHT {D_DepleteWeaponAmmo;A_PlaySound("weapons/firegrenade");}
		TNT1 A 0 A_Jump(92,2)
		TNT1 A 0 {
			if (GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Acid");
			}
			if (GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Disintegrate") &&
				GetTargetDamageFactor("Explosive") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Frag");
			}
			if (GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Fire") &&
				GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Ice") > GetTargetDamageFactor("Disintegrate")){
				return state("Missile.GrenadeLauncher.Cryo");
			}
			if (GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Disintegrate") &&
				GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Explosive") &&
				GetTargetDamageFactor("Fire") > GetTargetDamageFactor("Ice")){
				return state("Missile.GrenadeLauncher.Incendiary");
			}
			return state("");
		}
	Missile.GrenadeLauncher.Frag://Explosive
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_FragGrenade")
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Acid://Disintegrate
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_AcidGrenade")
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Cryo://Ice
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_CryoGrenade")
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.Incendiary://Fire
		TNT1 A 0 A_SpawnGravityProjectile("PBMarine_IncendiaryGrenade")
		goto Missile.GrenadeLauncher.End
	Missile.GrenadeLauncher.End:
		MRGL A 3 BRIGHT D_DoMarineDelayFireFX("MarineGLFireDelay")
		TNT1 A 0 A_Jump(256,"See")
	MissileBackup:
		TNT1 A 0 A_Jump(256,"Missile.Rifle","Missile.SMG","Missile.Carbine")
	Missile.Railgun:
		TNT1 A 0 A_PlaySound("RAILON",CHAN_AUTO)
		MRRG A 5 {A_MakeShootable();A_ChangeFlag("SOLID", 1);A_FaceTarget;}
		TNT1 A 0 D_AbortAndReloadIfEmpty("PB_Railgun")
		TNT1 A 0 A_AllyAlertMonsters(400,AMF_TARGETEMITTER)
		TNT1 A 0 A_PlaySound("RAILF1", CHAN_WEAPON)
		MRRG A 0 A_CustomRailgun(0,40,"none","none",RGF_FULLBRIGHT,0,0,"BulletPuff")
		MRRG A 0 D_DepleteWeaponAmmo("PB_Railgun",12)
		MRRG A 0 A_AllySpawnProjectile("PBMarine_RailgunWallPenetrationHitscan", 32)
		MRRG A 0 A_AllySpawnProjectile("PBMarine_GaussSiegeDamageAndPuff",32)
		MRRG A 2 BRIGHT A_AllySpawnProjectile("PBMarine_RailgunLaserBlast1",32,0,0,0)
		MRRG A 35 A_FaceTarget
		TNT1 J 0 A_Jump(256,"See")
	Missile.Plasma:
		TNT1 A 0 A_PlaySound("PLSDRAW",CHAN_AUTO)
		PLA6 E 5 {A_FaceTarget;A_ChangeFlag("SOLID", 1);A_MakeShootable();}
		TNT1 A 0 A_JumpIfCloser(325, 2)
		TNT1 A 0 A_Jump(256, 2)
		TNT1 A 0 A_JumpIf(random(0,2) > 1 && CheckTargetSurroundingEnemies(200)>2,"Missile.Plasma.BlastAlt")
		TNT1 A 0 D_DoMarineFireFX("MarinePlasmaFire",8)
		PLA6 FFEFFEFFEFFEFFEFFEFFEFFE 1
		TNT1 A 0 A_Jump(256,"See")
	Missile.Demontech:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PLA6 E 5 A_FaceTarget
		TNT1 A 0 A_AllyAlertMonsters(200,AMF_TARGETEMITTER)
		TNT1 A 0 {
			if(GetTargetDamageFactor("Disintegrate") > GetTargetDamageFactor("Fire") || GetTargetDamageFactor("Disintegrate") == GetTargetDamageFactor("Fire")){
				D_DoMarineFireFX("MarineDemonTechFire2",8);
			}else{
				D_DoMarineFireFX("MarineDemonTechFire",8);
			}
		}
		PLA6 FEFEFEFEFEFEFEFE 2
	Missile.Plasma.BlastAlt:
		PLA6 E 4 {
			if(!D_AbortAndReloadIfEmpty("PB_M1Plasma", null, 20)){
			A_StopSound(6);
			A_AllyAlertMonsters(200,AMF_TARGETEMITTER);
			A_StartSound("ULTCHAR", CHAN_AUTO, CHANF_OVERLAP);
			}
		}
		PLA6 E 1 BRIGHT {
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2));
			A_StartSound("PLSC_1",CHAN_AUTO, CHANF_OVERLAP);
		}
		PLA6 F 2 BRIGHT {
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2));
			A_StartSound("PLSC_2",CHAN_AUTO, CHANF_OVERLAP);
		}
		PLA6 F 3 BRIGHT {
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2));
			A_StartSound("PLSC_3",CHAN_AUTO, CHANF_OVERLAP);
		}
		PLA6 F 3 BRIGHT {
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2));
			A_StartSound("PLSC_4",CHAN_AUTO, CHANF_OVERLAP);
		}
		PLA6 EFE 1 BRIGHT A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2))
		PLA6 FEFE 1 BRIGHT {
			A_SpawnProjectile("BlueFlareSpawn",40);
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-2,2),random(-2,2),0,random(-2,2));
			}
		TNT1 A 0 A_StartSound("PLSFULL",1,CHANF_LOOPING)
		PLA6 FEFE 1 BRIGHT {
			A_SpawnItem("PlasmaGauntlet", 0, 1, 0, 0);
			A_SpawnItem("PlasmaGauntlet", 0, 1, 0, 0);
			A_SpawnProjectile("BlueFlareSpawn",40);
			A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-5,5),random(-2,2),0,random(-2,2));
			}
		PLA6 F 1 BRIGHT {
			A_StopSound(CHAN_6);
			A_StartSound("PLSULT", CHAN_WEAPON);
			PBCM_SpawnProjectile("PBMarine_M1_HeatWave",40);
			A_SpawnItemEx ("HeatBlastEffect3",0,0,16,0,0,0,0,SXF_NOCHECKPOSITION,0);
			A_SpawnProjectile("GunFireSmokeBig",40);
			A_SpawnProjectile("GunFireSmokeBig",40);
			A_SpawnProjectile("GunFireSmokeBig",40);
			A_SpawnProjectile("GunFireSmokeBig",40);
			D_DoMarineDelayFireFX("MarinePlasmaCoolDown");
		}
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnProjectile("RailGunTrailSpark_Fast",-15,random(-35,35),random(-32,32),0,random(-12,12))
		TNT1 A 0 A_Jump(256,"See")
