ACTOR Marine_AutoShotgun: PBMarine{
	DropItem "AutoShotgunMarineDrop"
	DropItem "PB_GrenadeAmmo" 5
	Translation  "112:127=64:79", "48:79=64:79"
	PBMarine.MarineWeapon "PB_Autoshotgun"
	PBMarine.AllyCountedInventory "NumberOfAlliesAutoShotgun"
	PBMarine.AllyMapCounter "NumberOfAlliesAutoShotgunThisMap"
	Obituary "%o has been gunned down by an Autoshotgun Marine."
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		TNT1 A 0 A_StartVoiceLine("MarineGuard", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle2", 50, 0, 0, 2, 90)
		PASG A 30
		TNT1 A 0 MarineModeSpawn("AutoShotgunMarineGuarding")
		Stop
	Spawn:
		PASG A 1 NODELAY A_Look
		TNT1 A 0 A_Jump(256,"See")
	//See:
		TNT1 A 0 D_StartReloadIfEmpty
		TNT1 A 0 //D_StartReloadIfNotFull2
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)	
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG AA 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFlag("FAST", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 1)
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPLayer")
		TNT1 A 0 A_ChangeFLag("FRIENDLY", 0)
		TNT1 A 0 A_MakeNotShootable()
		PASG AA 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG BB 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG CC 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		PASG DD 1 A_AllyChaseSee
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_FollowIfPlayer
		TNT1 A 0 A_Jump(256,"See")
	//BecomeEnemy23:
		PASG A 1
		goto BecomeEnemy24
	//FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FAST", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		PASG A 1 A_AllyChaseFollow
		TNT1 AA 0 PB_MarineStep
		PASG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG AA 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG BB 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 PB_MarineStep
		PASG CC 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		PASG DD 1 A_AllyChaseFollow
		TNT1 A 0 PB_MarineStep
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfTargetInLOS("See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Loop
	Waits:
		PASG E 1 D_StartReloadIfNotFullIdle
		TNT1 A 0 A_JumpIfTargetIsPlayer(3)
		TNT1 A 0 A_ClearTarget
		TNT1 A 0 A_Jump(256,"See")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 A_JumpIfTargetIsMarine("BecomeEnemy23")
		TNT1 A 0 A_Jump(32, "Waits2")
		TNT1 A 0 A_Jump(32, "Waits3")
		PASG EE 8 A_Stop
		TNT1 A 0 A_Stop
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer
	
	Waits2:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PASG E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWT", 2)
		PASG E 8 A_Stop
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	Waits4:
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		PASG E 8 A_Stop
		TNT1 A 0 A_StartVoiceLine("MRNWC", 2)
		PASG E 8 A_Stop
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 1);A_ClearTarget;A_MakeShootable();}
		TNT1 D 0 A_Look
		TNT1 A 0 {A_ChangeFLag("FRIENDLY", 0);A_MakeNotShootable();}
		PASG E 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSIght("FollowPlayer")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPLayer
	
	GiveAmmo:
		PASG A 10 A_FaceTarget
		PASG X 30 A_StartVoiceLine("MRNGI1")
		goto HandOverAmmo
	GiveHealth:
		PASG A 10 A_FaceTarget
		PASG Y 30 A_StartVoiceLine("MRNGI2")
		goto HandOverStimpack
	
	//Missile:
		PASG E 1
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon")||
				CheckTargetSpecies("BigFatAss")||CheckTargetClass("PB_Mancubus")||CheckTargetClass("Fatso")||
				CheckTargetClass("BaronofHell")||CheckTargetClass("PB_Baron"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("FollowPlayer")
		TNT1 A 0 A_JumpIfTargetIsPlayer("CheckRangeToWait")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(60, "AttackKick")
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		TNT1 A 0 A_StartVoiceLine("MRNAT", 2)
	Missile2:
	Missile.AutoShotgun:
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		PASG E 5 A_FaceTarget
		PLA3 E 0 A_Jump(128,2)
		TNT1 A 0 A_JumpIf(CheckTargetSurroundingEnemies(200)>2,"Missile.AutoShotgun.Flak")
	Missile.AutoShotgun.Loop:
		//TNT1 A 0 A_AllyAlertMonsters(500,AMF_TARGETEMITTER)
		//TNT1 A 0 D_AbortAndReloadIfEmpty
		//TNT1 AAAAAAAA 0 PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)))
		PASG F 2 BRIGHT D_DoMarineFireFX("MarineASGFire",random(5,8))//{D_DepleteWeaponAmmo;A_PlaySound("weapons/AutoShotgun", 1);A_SpawnProjectile("ShotgunWad", 32,random(-1,1),random(-1,1),0,random(-1,1));}
		PASG E 7 //{A_FaceTarget;PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}
		//TNT1 A 0 A_MarineRefire(92, "See")
		TNT1 A 0 A_JumpIfFireAction("Missile.AutoShotgun.Loop")
		goto See
		PLA3 E 0 A_Jump(256,"Missile.AutoShotgun.Loop")
		
	Missile.AutoShotgun.Flak:
		PASG F 3 BRIGHT {
			A_AllyAlertMonsters(500,AMF_TARGETEMITTER);
			A_PlaySoundEx("FLAKFIRE", "Weapon");
			A_FaceTarget;
			D_DepleteWeaponAmmo("PB_Autoshotgun",2);
			A_SpawnProjectile("ShotgunWad", 32,random(-1,1),random(-1,1),0,random(-1,1));
			A_SpawnProjectile("ShotgunWad", 32,random(-1,1),random(-1,1),0,random(-1,1));
			A_SpawnGravityProjectile("PBMarineASG_Chunk2",13,18,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk1",-18,15,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk3",5,13,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk3",-15,0,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk4",-15,0,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk1",8,-13,random(-2,2));
			A_SpawnGravityProjectile("PBMarineASG_Chunk2",12,-18,random(-2,2));
		}
		PASG E 0 D_DoMarineDelayFireFX("MarineAutoShotgunPump")
		PLA3 E 0 A_Jump(256,"See")
	StrafeLeft:
		PASG A 3 A_FaceTarget
		PASG B 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		PASG C 3 A_FaceTarget
		PASG D 3 ThrustThing(angle*256/360+192, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		TNT1 A 0 A_Jump(256,"Missile2")
	StrafeRight:
		PASG A 3 A_FaceTarget
		PASG B 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		PASG C 3 A_FaceTarget
		PASG D 3 ThrustThing(angle*256/360+64, 3, 0, 0)
		TNT1 D 0 A_JumpIfCannotFire("See")
		TNT1 A 0 A_Jump(256,"Missile2")
	Retreat:
		PASG D 3 A_FaceTarget
		PASG C 3 A_Recoil(5)
		TNT1 A 0 A_Recoil(5)
		PASG BA 3 A_FaceTarget
		Goto MIssile2
	Pain:
		PASG G 3
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		PASG G 3 A_Pain
		Goto FollowPlayer
	Death:
	Death.Bullet:
		TNT1 A 0 A_CustomMissile ("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160))
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PASG H 10 A_PlayerScream
		
		PASG I 10 A_NoBlocking
		PASG J 10 
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PASG KLM 10
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PASG N -1
		Stop
	Death.Blast:
	Death.SuperPunch:
	Death.SSG:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("USESPECIAL", 0)
		PASG O 2 A_FaceTarget
		TNT1 AAAA 0 A_CustomMissile ("XDeath1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath2", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("XDeath3", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 AAAA 0 A_CustomMissile ("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_CustomMissile ("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40))
		TNT1 A 0 A_XScream
		TNT1 A 0 A_NoBlocking
		TNT1 A 0 //A_SpawnItemEx("RemoveMarineShotgun",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		PASG OPQRSTU 8
		TNT1 A 0 A_SpawnItem ("MediumBloodSpot")
		PASG U -1
		Stop
	}
}

ACTOR AutoShotgunMarineGuarding: Marine_AutoShotgun{
	FastSpeed 0
	MaxStepHeight 0
	+FRIENDLY
	+MISSILEMORE
	+NODROPOFF
	+MISSILEEVENMORE
	+SHOOTABLE
	Speed 0
	States{
	Active:
		TNT1 A 0 A_ChangeFlag("NOBLOCKMAP", 1)
		TNT1 A 0 A_StartVoiceLine("MarineFollow", 2)
		TNT1 A 0 A_CustomMissile ("OrderTitle1", 50, 0, 0, 2, 90)
		TNT1 A 0 A_StartSoundIfNoVoice("marine/radiostatic",2,CHANF_OVERLAP)
		PASG A 30
		TNT1 A 0 MarineModeSpawn("Marine_AutoShotgun")
		Stop
		
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_GiveInventory("TargetIsAMarine")
		PASG E 1 A_Look
		TNT1 A 0 A_Jump(256,"See")
		
	See:	
		//TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_MakeNotShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 0)
		TNT1 A 0 D_StartReloadIfEmpty//A_StartReloadIfEmpty("MarineASGReload")
		PASG EEEEEEEEEEEEEEEE 1 A_AllyChaseGuard
		TNT1 A 0 A_SetAngle(random(90, -90) + angle)
		TNT1 A 0 A_ClearTarget
		Loop
		
	//Missile:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_SpawnItem("KillMeSmall")
		TNT1 A 0 A_JumpIf(CheckTargetSpecies("Mastermind")||CheckTargetClass("SpiderMastermind")||CheckTargetClass("PB_Mastermind")||
				CheckTargetSpecies("CyberDemon")||CheckTargetClass("CyberDemon")||CheckTargetClass("PB_Cyberdemon"),"CheckRetreat")
		TNT1 A 0 A_JumpIfTargetIsMarine("Spawn")
		TNT1 A 0 A_MakeShootable()
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		goto Missile2
		
	Pain:
		PASG G 3
		PASG G 3 A_Pain
		TNT1 A 0 A_Jump(128, "StrafeLeft", "StrafeRight")
		TNT1 A 0 A_Jump(256,"See")
	}
}
