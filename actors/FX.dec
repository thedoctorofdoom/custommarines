ACTOR PBMarineMuzzle1{
	Speed 0
	PROJECTILE
	+NOCLIP
	+NOGRAVITY
	Speed 5
	States{
	Spawn:
		TNT1 A 4
		TNT1 A 0 A_Stop
		PLMZ A 1 BRIGHT
		PLMZ A 1 BRIGHT A_SetScale(0.6)
		Stop
	}
}
