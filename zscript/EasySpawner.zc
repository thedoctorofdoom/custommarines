class Marine: RedTorch{
	Default{
		Radius 10;
		Height 48;
		MONSTER;
		-SHOOTABLE;
		-COUNTKILL;
		-FRIENDLY;
	}
	States{
	Spawn:
		PLA1 A 10;
		PLA1 A 1 A_CheckSight("DontSpawn");
		TNT1 A 0 A_Chase;
		TNT1 A 0 A_Look;
	See:	
		TNT1 A 0 ;//A_GiveToTarget("NumberOfAllies", 1);
		TNT1 A 0 A_SpawnItemEx ("PBMarineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
		Stop;
	DontSpawn:
		PLA1 A 1;
		Goto Spawn;
	}
}
