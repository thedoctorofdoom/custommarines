/*
	class<Ammo> AmmoTypeLeft;
	Ammo AmmoLeft;
*/
class MarinePistolReload : MarineReloadFX{
	States{
	Spawn:
		D5GB A 4;
		TNT1 A 7 {master.A_PlaySoundEx("PSRLOUT", "Auto");}
		TNT1 A 3 PB_SpawnCasing("EmptyClipMP40",28,0,30,3,Frandom(-8,-5),Frandom(1,4));
		TNT1 A 15 {master.A_PlaySoundEx("PSRLIN", "Auto");}
		TNT1 A 17 {master.A_PlaySoundEx("PSRLFIN", "Auto");}
		stop;
	}
}
class MarinePistolReload2 : MarineReloadFX{
	States{
	Spawn:
		D5GB A 4;
		TNT1 A 7 {master.A_PlaySoundEx("PSRLOUT", "Auto");}
		TNT1 A 3 ;//PB_SpawnCasing("EmptyClipMP40",28,0,30,3,Frandom(-8,-5),Frandom(1,4));
		TNT1 A 15 {master.A_PlaySoundEx("PSRLIN", "Auto");}
		stop;
	}
}
class MarineRevolverReload : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 26;
	}
	States{
	Spawn:
		TNT1 A 6 NODELAY {master.A_PlaySound("Ironsights");}
		TNT1 A 10 {master.A_PlaySoundEx("Weapons/Revolver/Open", "Auto");}
		TNT1 A 4 {master.A_PlaySoundEx("Weapons/Revolver/Click2", "Auto");}
		TNT1 AAAAAA 0 {
			//master.A_SpawnProjectile("MagnumCasing",-5,0,0,-30);//PB_RevolverCasingSpawn("RevolverAmmo")
			PB_SpawnCasing("MagnumCasing", 45.6, 9, 18.75,frandom(-0.5,0.5),frandom(-0.4, -0.2), frandom(0.5,-0.5));
		}
		R6V1 A 7;
		R6V2 A 7 {master.A_PlaySoundEx("Weapons/Revolver/Load", "Auto");}
		TNT1 A 3 {
			master.A_PlaySoundEx("CYLNSPIN", "Auto");
			PB_SpawnCasing("RevolverSpeedLoader", 45.6, 9, 18.75,frandom(-1,1),frandom(-1.2, -0.6), frandom(1,-1));
		}
		TNT1 A 9 {master.A_PlaySoundEx("Weapons/Revolver/Close", "Auto");}
		stop;
	}
}
class MarineRevolverReload2 : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 26;
	}
	States{
	Spawn:
		TNT1 A 6 NODELAY {master.A_PlaySound("Ironsights");}
		TNT1 A 10 {master.A_PlaySoundEx("Weapons/Revolver/Open", "Auto");}
		TNT1 A 4 {master.A_PlaySoundEx("Weapons/Revolver/Click2", "Auto");}
	LoadLoop:
		TNT1 A 0 {
			//master.A_SpawnProjectile("MagnumCasing",-5,0,0,-30);//PB_RevolverCasingSpawn("RevolverAmmo")
			PB_SpawnCasing("MagnumCasing", 45.6, 9, 18.75,frandom(-0.5,0.5),frandom(-0.4, -0.2), frandom(0.5,-0.5));
		}
		R6V1 A 7 A_JumpIfReloadCounter("LoadLoop");
		R6V2 A 7 {master.A_PlaySoundEx("Weapons/Revolver/Load", "Auto");}
		TNT1 A 3 {
			master.A_PlaySoundEx("CYLNSPIN", "Auto");
			PB_SpawnCasing("RevolverSpeedLoader", 45.6, 9, 18.75,frandom(-1,1),frandom(-1.2, -0.6), frandom(1,-1));
		}
		TNT1 A 9 {master.A_PlaySoundEx("Weapons/Revolver/Close", "Auto");}
		stop;
	}
}
class MarineDeagleReload : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 26;
	}
	States{
	Spawn:
		TNT1 A 0 NODELAY A_JumpIfReloadCounter("Reload2");
		D1E0 ABCDEFG 1;
		D1E0 H 1 {A_PlaySoundEx("weapons/deagle/magout", "Auto");A_PlaySoundEx("PSRLOUT", "Auto");}
		D1E0 IJKLM 1 ;
		D1E0 N 3 A_CustomMissile("EmptyDeagleMag",5,0,12,-4);
		D1E0 OP 1 ;
		D1E0 Q 1 {A_PlaySoundEx("weapons/deagle/magin", "Auto");A_PlaySoundEx("RIFCL_IN", "Auto");}
		D1E0 RSTUVWXY 1;
		D1E0 Z 1 A_PlaySoundEx("weapons/deagle/click1", "Auto");
		D1E1 ABCD 1;
		D1E1 D 1 A_PlaySoundEx("weapons/deagle/click2", "Auto");
		D1E1 EFGHIJKL 1;
		stop;
	Reload2:
		D0E0 ABCDEFGHIIIIJKL 1;
		D0E0 M 1 {A_PlaySoundEx("weapons/deagle/magout", "Auto");A_PlaySoundEx("PSRLOUT", "Auto");}
		D0E0 NO 1;
		D1E2 N 3 A_PlaySoundEx("Ironsights", "Auto");
		D1E2 P 3;
		D1E2 Q 1 {A_PlaySoundEx("weapons/deagle/magin", "Auto");A_PlaySoundEx("RIFCL_IN", "Auto");}
		D1E2 RSTUV 1;
		D1E1 EFGHIJKL 1;
		stop;
	}
}
class MarineDeagleReload2 : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 26;
	}
	States{
	Spawn:
		D0E0 ABCDEFGHIIIIJKL 1;
		D0E0 M 1 {A_PlaySoundEx("weapons/deagle/magout", "Auto");A_PlaySoundEx("PSRLOUT", "Auto");}
		D0E0 NO 1;
		D1E2 N 3 A_PlaySoundEx("Ironsights", "Auto");
		D1E2 P 3;
		D1E2 Q 1 {A_PlaySoundEx("weapons/deagle/magin", "Auto");A_PlaySoundEx("RIFCL_IN", "Auto");}
		D1E2 RSTUV 1;
		D1E1 EFGHIJKL 1;
		stop;
		D1E0 ABCDEFG 1;
		D1E0 H 1 {A_PlaySoundEx("weapons/deagle/magout", "Auto");A_PlaySoundEx("PSRLOUT", "Auto");}
		D1E0 IJKLM 1 ;
		D1E0 N 3 A_CustomMissile("EmptyDeagleMag",5,0,12,-4);
		D1E0 OP 1 ;
		D1E0 Q 1 {A_PlaySoundEx("weapons/deagle/magin", "Auto");A_PlaySoundEx("RIFCL_IN", "Auto");}
		D1E0 RSTUVWXY 1;
		D1E0 Z 1 A_PlaySoundEx("weapons/deagle/click1", "Auto");
		D1E1 ABCD 1;
		D1E1 D 1 A_PlaySoundEx("weapons/deagle/click2", "Auto");
		D1E1 EFGHIJKL 1;
		stop;
	}
}
class MarineSMGReload : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 37;
	}
	States{
	Spawn:
		/*
		A1F0 A 5;
		TNT1 A 5 {master.A_StartSound("RIFCL_CK", CHAN_AUTO);}
		A1F0 K 4 {master.A_StartSound("weapons/mar/smg_out", CHAN_AUTO);}
		TNT1 A 2 {master.A_StartSound("weapons/mar/smg_up", CHAN_AUTO);}
		TNT1 A 14 PB_SpawnCasing("SMGEmptyMagazine",28,0,30,3,Frandom(-8,-5),Frandom(1,4));
		A2F4 A 7 {master.A_StartSound("weapons/mar/smg_in", CHAN_AUTO);}
		TNT1 A 5 {master.A_PlaySoundEx("IronSights", "Auto");}
		TNT1 A 5 {master.A_PlaySoundEx("weapons/mar/smg_click", "Auto");}
		A2F4 A 9;
		stop;
	NewReload:
		*/
		TNT1 A 2 NODELAY A_StartSound("weapons/smg/raise");
		TNT1 A 0 A_JumpIfReloadPartial("ReloadPartial");
		goto BoltPull;
	BoltPull:
		TNT1 A 2 A_StartSound("weapons/smg/raise");
		TNT1 A 6 A_StartSound("weapons/smg/armup", CHAN_AUTO);
		TNT1 A 11 A_StartSound("weapons/smg/boltlock", CHAN_AUTO);
		Goto ReloadEmpty;
	ReloadPartial:
		TNT1 A 2;
		TNT1 A 7 A_StartSound("weapons/rifle/magchange", CHAN_AUTO);
		TNT1 A 16 A_StartSound("weapons/smg_out", CHAN_AUTO);
		Goto ReloadContinue;
	ReloadEmpty:
		TNT1 A 1;
		TNT1 A 7 A_StartSound("weapons/rifle/magchange", CHAN_AUTO);
		TNT1 A 16 A_StartSound("weapons/smg_out", CHAN_AUTO);
		TNT1 A 0 PB_SpawnCasing("SMGEmptyMagazine",28,0,30,3,Frandom(-8,-5),Frandom(1,4));
	ReloadContinue:
		TNT1 A 5 A_StartSound("weapons/smg/tilt");
		TNT1 A 1 A_PlaySoundEx("weapons/smg_in", "Auto");
	InsertBullets2:
		TNT1 A 6 A_JumpIfReloadPartial("LoadChamber");
		TNT1 A 6 A_StartSound("weapons/smg/lower");
	LoadChamber:
		TNT1 A 12;
		TNT1 A 5 A_StartSound("weapons/smg/armswing", CHAN_AUTO);
		TNT1 A 17 A_PlaySoundEx("weapons/smg_click", "Auto");
		stop;
	}
}
class MarineSMGReload2 : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 37;
	}
	States{
	Spawn:
		A1F0 A 10;
		A1F0 K 4 {master.A_StartSound("weapons/mar/smg_out", CHAN_AUTO);}
		TNT1 A 16 {master.A_StartSound("weapons/mar/smg_up", CHAN_AUTO);}
		A2F4 A 7 {master.A_StartSound("weapons/mar/smg_in", CHAN_AUTO);}
		TNT1 A 5 {master.A_PlaySoundEx("IronSights", "Auto");}
		TNT1 A 14 ;
		stop;
	AltReload:
		stop;
	}
}
