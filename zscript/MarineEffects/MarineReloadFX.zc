class MarineMG42BarrelChange : MarineReloadFX{
	States{
	Spawn:
		MGC1 A 15;
		TNT1 A 17 {master.A_PlaySound("MG42OP");}
		TNT1 A 10 {master.A_PlaySound("MG42RE");}
		TNT1 A 17 {master.A_PlaySound("MG42IN");}
