class MarineLMGReload : MarineReloadFX{
	States{
	Spawn:
		TNT1 A 9;
		TNT1 A 10 {master.A_StartSound("LLIDOP");}
		LLBU A 19;
		TNT1 A 5 {master.A_StartSound("weapons/sgl/detach", 3);}
		TNT1 A 8 PB_SpawnCasing("EmptyLMGMag", 12, -2.5, 10.25,frandom(2,5),frandom(1,3),frandom(2,4));
		TNT1 A 10 {master.A_StartSound("weapons/lmg/magin", 4);}
		TNT1 A 18 {master.A_StartSound("weapons/riflemagslap", 5);}
		TNT1 A 16 {master.A_StartSound("LFEED");}
		TNT1 A 10 {master.A_StartSound("LLIDCL");}
		Rechamber:
		TNT1 A 6;
		TNT1 A 12 {master.A_StartSound("IronSights", 1);master.A_StartSound("LMGCLK", 2);}
		stop;
	}
}
