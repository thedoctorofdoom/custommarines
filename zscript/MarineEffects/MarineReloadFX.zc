class MarineASGReloadDrum : MarineReloadFX{
	Default{
		MarineReloadFX.MarineAttackCooldown 37;
	}
	States{
	Spawn:
		TNT1 A 13 NODELAY {master.A_PlaysoundEx("weapons/autoshotgun/drumreload1", "Auto");}
		TNT1 A 2 {master.A_PlaysoundEx("weapons/autoshotgun/drumreload2", "Auto");}
		TNT1 A 0 PB_SpawnCasing("EmptyASGDrum",28,0,30,3,Frandom(-8,-5),Frandom(1,4));
		//TNT1 A 0 {master.A_FireCustomMissile("EmptyASGDrum",-5,0,0,-4);}
		AU34 A 4 {master.A_PlaysoundEx("Ironsights", "Auto");}
		TNT1 A 7 {master.A_PlaySoundEx("weapons/sgmvpump","Auto");}
		AVMD LM 1 ;
		AVMD N 1 ;
		AU34 O 1 ;
		TNT1 A 7 {master.A_PlaysoundEx("weapons/shotgun/detach", "Auto");}
		TNT1 A 4 {master.A_PlaysoundEx("weapons/riflemagslap", "Auto");}
		AU35 A 4 ;
		TNT1 A 3 {master.A_PlaySoundEx("weapons/sgpump","Auto");}
		AU33 A 3;
		AU33 A 4;
		stop;
	}
}
