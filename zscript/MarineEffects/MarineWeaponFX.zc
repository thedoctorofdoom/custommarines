	States{
	Spawn:
		N5N0 WXY 1;
		N8N0 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1;
		stop;
	}
}
class MarineNailgunJavelinSequence : MarineDelayFireFX{
	States{
	Spawn:
		PLSG JKLKJ 1 ;
		J1N0 GHIJKLMN 1;
		TNT1 A 2 {master.A_StartSound("weapons/nailgun/inspect2", CHAN_AUTO);}
		TNT1 A 10 {master.A_StartSound("weapons/nailgun/loadjavelin", CHAN_AUTO);}
		J2N0 ABCDEFGH 1;
		J0N0 D 14 ;
		stop;
	}
}
class MarinePlasmaCoolDown : MarineDelayFireFX{
	States{
	Spawn:
		PLSG JKLKJ 1 ;
		PLSU BCDE 1;
		TNT1 A 0 {master.A_StartSound("PLSCOOL",CHAN_VOICE);}
		PLSU FFFFFFFFF 2 A_SpawnProjectile("SmokeSpawner",32);
		PLSG DCB 1;
		stop;
	}
}
