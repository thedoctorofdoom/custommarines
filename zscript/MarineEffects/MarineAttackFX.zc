class MarineRLFire : MarineFireFX abstract{
	States{
	FireEnd:
		MRGL A 4 {master.bBRIGHT=false;master.A_FaceTarget();}
		TNT1 A 0 A_JumpIf(D_AbortAndReloadIfEmpty(null,null,1,null),"Firing_Empty");
		goto Firing_Normal_Single;
	Firing_Normal_Single:
		TNT1 A 7 {master.A_StartSound("weapons/rocket/innercycle", CHAN_AUTO, CHANF_OVERLAP);}
		TNT1 A 5 {master.A_StartSound("RLCYCLE2", CHAN_AUTO, CHANF_OVERLAP);}
		TNT1 A 9 {master.A_StartSound("weapons/rocket/loadingmechanism2", 1);}
		goto FireFinish;
	Firing_Empty:
		TNT1 A 21;
		goto FireFinish;
	FireFinish:
		TNT1 A 0 A_JumpIfShotCounter("Spawn");
		stop;
	}
}
