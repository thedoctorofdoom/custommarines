class MarineMinigunFire : MarineFireFX{
	States{
	Spawn:
	SpawnLoop:
		PL42 F 1 {
			A_AllyAlertMonsters(1000,AMF_TARGETEMITTER);
			master.bBRIGHT=true;
			master.A_FaceTarget();
			master.A_PlaySound("CHGNSHOT",CHAN_BODY, 1.0, False);
			PBCM_SpawnProjectile("PBMarine_556x45mmAP", 32, 0, random(-8, 8), 1, random(-3, 3)); PB_SpawnCasing("PB_EmptyBrass", 19,-13,24,0,-frandom(3,6),frandom(-1,1)); PB_SpawnCasing("LMGBeltLink", 19,-13,24,0,-frandom(1,2),frandom(-3,3));
		}
		PL42 E 2 {master.bBRIGHT=false;master.A_FaceTarget();}
		TNT1 A 0 A_JumpIfShotCounter("SpawnLoop");
		stop;
	}
}
class MarineMinigunFire2 : MarineFireFX{
	States{
	Spawn:
		TNT1 A 0 NODELAY {master.A_StartSound("weapons/minigunfire", CHAN_BODY, CHANF_LOOP);}
	SpawnLoop:
		PL42 F 1 {
			A_AllyAlertMonsters(1000,AMF_TARGETEMITTER);
			master.bBRIGHT=true;
			master.A_FaceTarget();
			PBCM_SpawnProjectile("PBMarine_556x45mmAP", 32, 0, frandom(-8.5, 8.5), 1, frandom(-3.5, 3.5)); PB_SpawnCasing("PB_EmptyBrass", 19,-13,24,0,-frandom(3,6),frandom(-1,1)); PB_SpawnCasing("LMGBeltLink", 19,-13,24,0,-frandom(1,2),frandom(-3,3));
		}
		PL42 E 1 {master.bBRIGHT=false;master.A_FaceTarget();}
		TNT1 A 0 A_JumpIfShotCounter("SpawnLoop");
		TNT1 A 0 {
			master.A_StopSound(CHAN_BODY);
			master.A_PlaySound("CHAINSTO",CHAN_BODY, 1.0, False);
		}
		stop;
	}
}
