class MarineGLFire : MarineFireFX abstract{
	States{
	Spawn:
	FireEnd:
		MRGL A 1 NODELAY {if(!D_AbortAndReloadIfEmpty("PB_SuperGL")){
			A_AllyAlertMonsters(500,AMF_TARGETEMITTER);
			master.bBRIGHT=true;
			master.A_FaceTarget();
			master.A_PlaySound("weapons/firegrenade");
			D_DepleteWeaponAmmo("PB_SuperGL");
			}
		}
		MRGL A 2 PB_SpawnCasing("EmptyGrenadeBrass", 30, 0, 34, -frandom(1, 3), -frandom(2, 4), 5);
		TNT1 A 14 {master.bBRIGHT=false;master.A_FaceTarget();master.A_StartSound("RLCYCLE2", 13);}
		TNT1 A 8 {master.A_StartSound("weapons/sgl/cycle", 9);}
		TNT1 A 0 A_JumpIfShotCounter("Spawn");
		stop;
	}
}
