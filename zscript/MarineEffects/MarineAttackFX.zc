Class MarineFragThrow: MarineFireFX{
	States{
	Spawn:
		PLA1 A 1 {master.SetInventory("PlayerIsThrowingAGrenade",1);master.A_StartSound("OPNGRN",CHAN_AUTO);}
		PLA1 ABBCCDDAA 1 {master.A_FaceTarget();}
		PLA1 E 6 BRIGHT {A_StartSound("THRGRN",CHAN_AUTO);A_SpawnGravityProjectile("MarineThrownGrenade");}
		#### # 0 {master.SetInventory("PlayerIsThrowingAGrenade",0);}
		stop;
	}
}
class MarineASGFire : MarineFireFX{
	States{
	Spawn:
		PASG F 2 NODELAY {if(!D_AbortAndReloadIfEmpty("PB_Autoshotgun")){
			A_AllyAlertMonsters(1000,AMF_TARGETEMITTER);
			master.bBRIGHT=true;
			master.A_FaceTarget();
			D_DepleteWeaponAmmo("PB_Autoshotgun");
			PBM_StartSound("weapons/AutoShotgun");
			PBM_MuzzleFlash("PBMarineMuzzle1",34);
			for(int i = 0; i < 8; i++){
				PBCM_SpawnProjectile("PBMarine_12GAPellet_ASG", 32, 0, frandom(-1*frandom(5.84,6.45),frandom(5.84,6.45)), 1, frandom(-1*frandom(5.2,6.75),frandom(5.2,6.75)));
			}
			PBCM_SpawnProjectile("ShotgunWad", 32,random(-1,1),random(-1,1),0,random(-1,1));
			}
		}
		PASG E 7 {master.bBRIGHT=false;master.A_FaceTarget();PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);}
		TNT1 A 0 A_JumpIfShotCounter("Spawn");
		stop;
	}
}
