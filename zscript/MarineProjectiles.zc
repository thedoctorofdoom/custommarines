	}
	States{
		Spawn:
			TNT1 A 1 BRIGHT;
			TNT1 A 1 BRIGHT;
			Stop;
		Death:
			TNT1 A 0;
			PUFF A 0 A_PlaySound("player/cyborg/fist");
			EXPL AAAAAA 0 A_CustomMissile("MeleeSmoke", 0, 0, random (0, 360), 2, random (0, 360));
			TNT1 A 10;
			Stop;
	}
}

class MarineMeleeStrikeSuper: MarineMeleeStrike{
