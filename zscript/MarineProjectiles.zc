Class PBMarineProjectile : actor{
	Default{
		Projectile;
		Species "Marines";
		+DontHurtSpecies
		+THRUSPECIES
		+MTHRUSPECIES
		+DONTHARMSPECIES
	}
	override int DoSpecialDamage(Actor victim, int damage, Name damagetype){
		if (victim is "PlayerPawn" || victim is "PBMarine"){return 0;}
		if(victim.bBOSS){
			damage *= pb_marine_boss_damage_factor;
		}
		return pb_marine_damage_factor * super.DoSpecialDamage(victim, damage, damagetype);
	}
	override int SpecialMissileHit(Actor victim){
		if(victim is "PlayerPawn" || victim is "PBMarine" || !victim.bSHOOTABLE){
			return 1;
		}
		return Super.SpecialMissileHit(victim);
	}
}
Class PBMarineFastProjectile : FastProjectile{
	Default{
		Species "Marines";
		+THRUSPECIES
		+MTHRUSPECIES
		+DONTHARMSPECIES
	}
	override int DoSpecialDamage(Actor victim, int damage, Name damagetype){
		if (victim is "PlayerPawn" || victim is "PBMarine"){return 0;}
		if(victim.bBOSS){
			damage *= pb_marine_boss_damage_factor;
		}
		return pb_marine_damage_factor * super.DoSpecialDamage(victim, damage, damagetype);
	}
	override int SpecialMissileHit(Actor victim){
		if(victim is "PlayerPawn" || victim is "PBMarine" || !victim.bSHOOTABLE){
			return 1;
		}
		return Super.SpecialMissileHit(victim);
	}
}

Class PBMarineASG_Chunk1 : PBMarineProjectile{
	Default{
		Radius 3;
		Height 4;
		Speed 45;
		Damage 8;
		Mass 200;
		Scale 0.4;
		Damagetype "Cutless";
		+MISSILE
		+DOOMBOUNCE
		+BLOODSPLATTER
		+ROLLSPRITE
		BounceFactor 0.65;
		SeeSound "weapons/smcasebounce";
		BounceSound "weapons/smcasebounce";
		MissileType "FlakTrail";
	}
	States{
		Spawn:
			FLAS A 1 Bright {
				A_CustomMissile("YellowFlareSpawn", 0, 0, 0, 0);
				A_SpawnItemEx("FlakTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_SetRoll(Roll+45);
			}
			loop;
		Death:
			EXPL AAA 0 A_CustomMissile ("ExplosionSmokeSmall22", 4, 0, random (0, 360), 2, random (0, 360));
			Stop;
	}
}

