	action float GetMarineEnemyRatio(){
		return I_SquadCount()/(level.total_monsters - level.killed_monsters);
	}
	action bool CheckMarinePickup(){
		if(pb_marinespickupitems){
			if(pb_marine_behavior_num_adaptation){
				if(I_SquadCount() < pickup_enable_squad_num){
					return true;
				}
				else{return false;}
			}
			else{return true;}
		}
		else{return false;}
	}
	action bool isDoingAction(){
		return (invoker.reloadingAction || invoker.delayFireFX || invoker.fireAction);
	}
	action bool A_CannotFire(){
		return (invoker.reloadingAction || invoker.delayFireFX);
	}
	bool ChaseFireAbility(){
		return delayFireFX || (reloadingAction && reloadingAction is "MarineReloadFX");
	}
	action bool CheckMarineExecution(){
		invoker.A_DebugLog("CheckMarineExecution called");
		if(pb_marinesglorykill){
			if (pb_marine_behavior_num_adaptation){
				if(
					I_SquadCount() < execution_enable_squad_num || invoker.health < 200
					&& !isDoingAction()){return true;}
				else{return false;}
			}
			else{return true;}
		}
		else{return false;}
	}
	action state PBMarine_Execute() {
		A_FaceTarget();
		if(!CheckMarineExecution()){return null;}
		if(target != NULL){
			if(target.bCountKill){
				LookExParams look;
				look.FOV = 360;
				Actor monster = target;
				if (monster.IsVisible(self, true, look) && CheckSight(monster) && Distance3D(monster) < 200 ){
					
					int targetMaxHealth = monster.spawnHealth();
					int targetCurrentHealth = monster.health;
					
					if (actorCanBeExecuted(monster)){
						// Move Monster and Player toward each other
						monster.A_Stop();
						double spd = 27.;
						vector3 delta = ( monster.pos.x - pos.x, monster.pos.y - pos.y, monster.pos.z - pos.z );
						double angleToMonster = AngleTo(monster);
						double pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
						monster.A_SetPitch(pitchToMonster, SPF_INTERPOLATE);
						monster.A_SetAngle(angleToMonster+180,SPF_INTERPOLATE);
						vector3 neworigin = Vec3Offset(cos(angleToMonster) * spd,  sin(angleToMonster) * spd, sin(pitchToMonster) * spd);
						monster.SetOrigin(neworigin,true);
						A_SetAngle(AngleTo(monster));
						pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
						A_SetPitch(-pitchToMonster);
						PB_SetMarineExecutionProperties();
						StateLabel st = "AttackExecute";//PB_ExecutionHandlerString(monster);
						monster.A_Die("Execution");
						return ResolveState(st);
					}
				}
			}
		}
		return null;
	}
	action void PBMarine_Execute_Tick() {
		if(!CheckMarineExecution()){return;}
		if(target != NULL){
			if(target.bCountKill){
				LookExParams look;
				look.FOV = 360;
				Actor monster = target;
				if (monster.IsVisible(self, true, look) && Distance3D(monster) < 200 ){
					
					int targetMaxHealth = monster.spawnHealth();
					int targetCurrentHealth = monster.health;
					
					if (actorCanBeExecuted(monster)){
						// Move Monster and Player toward each other
						monster.A_Stop();
						double spd = 27.;
						vector3 delta = ( monster.pos.x - pos.x, monster.pos.y - pos.y, monster.pos.z - pos.z );
						double angleToMonster = AngleTo(monster);
						double pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
						monster.A_SetPitch(pitchToMonster, SPF_INTERPOLATE);
						monster.A_SetAngle(angleToMonster+180,SPF_INTERPOLATE);
						vector3 neworigin = Vec3Offset(cos(angleToMonster) * spd,  sin(angleToMonster) * spd, sin(pitchToMonster) * spd);
						monster.SetOrigin(neworigin,true);
						A_SetAngle(AngleTo(monster));
						pitchToMonster = VectorAngle( sqrt(delta.y * delta.y + delta.x * delta.x), delta.z );
						A_SetPitch(-pitchToMonster);
						PB_SetMarineExecutionProperties();
						StateLabel st = "AttackExecute";//PB_ExecutionHandlerString(monster);
						monster.A_Die("Execution");
						SetState(ResolveState(st));
						return;
					}
				}
			}
		}
		return;
	}
	State A_JumpIfReloading(Statelabel jumpstate){
		State stateToJump = ResolveState(jumpstate);
		if(reloadingAction && stateToJump) return stateToJump;
		return ResolveState(null);
	}
	State A_JumpIfCannotFire(Statelabel jumpstate){
		State stateToJump = ResolveState(jumpstate);
		if(A_CannotFire() && stateToJump) return stateToJump;
		return ResolveState(null);
	}
