	//A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
	state A_FollowIfPlayer(statelabel followState = "FollowPlayer"){
		A_DebugLog("A_FollowIfPlayer called");
		if(target && target == master && ResolveState(followState)){
			A_DebugLog("A_FollowIfPlayer results in FollowState");
			return ResolveState(followState);
		}else{return ResolveState(null);}
	}
	action void PB_MarineStep(double multiplier = 1.0, double initialSpeed = 1.0, int repetitions = 1){
		if(pb_marinestepenabled){
			invoker.A_DebugLog("PB_MarineStep");
			for (int i = 0; i < repetitions; i++){
				A_Recoil(-1 * initialSpeed * multiplier);
			}
		}
	}
	action void PB_MarineStepDefault(int repetitions = 1){
		for (int i = 0; i < repetitions; i++){A_Recoil(-1);}
	}
	actor GetCommander(){
		if(master){return master;}
		else return GetClosestPlayer();
	}
	bool CheckTargetClass(string classname){return CheckClass(classname,AAPTR_TARGET,true);}
	bool CheckTargetSpecies(name species){
		if(target && target.GetSpecies() == species)return true;
		else return false;
	}
	int CheckPlayerinSurroundings(double rad = 256) {
		int ret = 0;
		foreach(pl : players) {
			bool valid = (pl.mo && pl.mo.health > 0 && pl.mo.Distance3D(self) <= rad && self.CheckSight(pl.mo));
			if (valid) { ret++; }
		}
		return ret;
	}
	action PlayerPawn GetClosestPlayer() {
		invoker.A_DebugLog("GetClosestPlayer called");
		int lastrange = int.max; // or is it int.max() ???
		PlayerPawn closest = null;
		int range = lastrange;	
		foreach(pl : players) {
			bool valid = (pl.mo && pl.mo.health > 0);// && self.CheckSight(pl.mo)); // you can remove this if LoS isn't a concern
				if (valid) {
					range = pl.mo.Distance3D(self);// <= rad;
					if (range < lastrange) { closest = pl.mo; }
				}
			}
		return closest;
	}
	double GetTargetDamageFactor(name dmgtype){
		A_DebugLog("GetTargetDamageFactor called");
		if (!target) return -1;
		let val = target.ApplyDamageFactor(dmgtype, 1000);
		return val * 0.001;
	}
	void A_FindPlayerTarget(){
		A_DebugLog("A_FindPlayerTarget called");
		if (target is "PlayerPawn") return;
		target = GetClosestPlayer();//players[0].mo;
		return;
	}
	state A_MarineRefire(int chancecontinue, statelabel abortstate = "See"){
		A_DebugLog("A_MarineRefire called");
		if(target && target is "PlayerPawn" || target is "PBMarine" || target is "PB_CapturedMarine"){refireCount = 0; return ResolveState(abortstate);}
		if(target && target.health <= 0){refireCount = 0;A_ClearTarget(); target = null; return ResolveState(abortstate);}
		if(!target){return ResolveState(abortstate);}
		state toReturn = A_MonsterRefire(chancecontinue, abortstate);
		if(toReturn) refireCount = 0;
		else refireCount += 1;
		return toReturn;
	}
