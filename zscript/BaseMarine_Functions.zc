	void A_SpawnGravityProjectile(class<Actor> missile, double spawnheight = 32, double spawnofs_xy = 0, double angle = 0, int flags = 0, double pitch = 0, int ptr = AAPTR_TARGET){
		if (!target)return;
		A_FaceTarget();
		actor proj = A_SpawnProjectile(missile, spawnheight, spawnofs_xy, angle, flags, pitch, ptr);
		if (proj){
			double dist = proj.Distance2D(target); // horizontal distance
			double flyTime = dist / Clamp(proj.speed, 0.1, 100); //time of flight
			double heightfactor = 0.5;
			if(target.pos.z + target.height > self.pos.z + spawnheight){
				heightfactor = 1;
			}
			double vdiff = target.pos.z + target.height * heightfactor - proj.pos.z;
			double vvel = (vdiff + 0.5 * flyTime * flyTime) / flyTime;
			vvel *= proj.GetGravity();
			double hvel = dist / flyTime;
			proj.VelFromAngle(hvel, proj.AngleTo(target));
			proj.vel.z = vvel;
			proj.bCANBOUNCEWATER = false;
			proj.bNOGRAVITY = false;
			proj.bUSEBOUNCESTATE = false;
			proj.bBOUNCEONWALLS = false;
			proj.bBOUNCEONFLOORS = false;
			proj.bBOUNCEONCEILINGS = false;
			proj.species = GetCommander().GetSpecies();
			proj.bDONTHARMCLASS = true;proj.bDONTHARMSPECIES = true;proj.bTHRUSPECIES = true;proj.bMTHRUSPECIES = true;proj.bDOHARMSPECIES = false;
		}
	}
	bool MissileLinesUp(actor target, double spawnheight = 32){
		if(!target)return false;
		bool linesUp = false;
		//float centerPos = (self.pos.z + self.height)/2;
		float firePos = (self.pos.z + spawnheight);
		float targetPosTop = target.pos.z + target.height;
		linesUp = (target.pos.z == self.pos.z);// || (firePos > target.pos.z && firePos < targetPosTop);
		return linesUp;
	}
	void PBCM_SpawnProjectile(class<Actor> missile, double spawnheight = 32, double spawnofs_xy = 0, double angle = 0, int flags = 0, double pitch = 0, int ptr = AAPTR_TARGET, int directionmode = 0){
		//CMF_AIMDIRECTION
		if(!target)return;
		if(directionmode == 0){
			if(random(0,1)>0 && target && MissileLinesUp(target,spawnheight)){
				A_Face(target,0,270,0,0,FAF_TOP);
				A_FaceTarget(0,270,0,FAF_TOP);
				flags |= CMF_AIMDIRECTION;
			}else{A_FaceTarget();}
		}
		actor proj = A_SpawnProjectile(missile, spawnheight, spawnofs_xy, angle, flags, pitch, ptr);
		if (proj){
			proj.species = GetCommander().GetSpecies();
			proj.bDONTHARMCLASS = true;proj.bDONTHARMSPECIES = true;proj.bTHRUSPECIES = true;proj.bMTHRUSPECIES = true;proj.bDOHARMSPECIES = false;
		}
	}
	void PBCM_SpawnProjectiles(int shots, class<Actor> missile, double spawnheight = 32, double spawnofs_xy = 0, double angle = 0, int flags = 0, double pitch = 0, int ptr = AAPTR_TARGET){
		if(random(0,1)>0){
			A_Face(target,0,270,0,0,FAF_TOP);
			flags |= CMF_AIMDIRECTION;
		}else{
			A_FaceTarget();
		}
		for (int i = 0; i < shots; i++){
			PBCM_SpawnProjectile(missile, spawnheight, spawnofs_xy, angle, flags, pitch, ptr, 1);
		}//directionmode
	}
	Action state A_JumpStrafeLeft(statelabel strafeLeft = "StrafeLeft"){
		State strafeLeftState = ResolveState(strafeLeft);
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, -self.radius) && strafeLeftState){
			return strafeLeftState;
		}
		return ResolveState(null);
	}
