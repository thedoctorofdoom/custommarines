	//"PB_Revolver","PB_SMG","PB_Shotgun","PB_SSG","PB_Rifle","Rifle","PB_Carbine","PB_Autoshotgun","PB_Minigun","PB_Nailgun","PB_RocketLauncher","PB_SuperGL","PB_M1Plasma","PB_M2Plasma","PB_Flamethrower","PB_Railgun","PB_BFG9000"
	void MarineModeSpawn(class<Actor> marineActor){
		if(self is "Marine_Minigun"){A_StopSound(1);}
		if(self is "Marine_Nailgun"){A_StopSound(CHAN_BODY);}
		actor marineSpawned; bool b;
		[b, marineSpawned] = A_SpawnItemEx(marineActor,0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERTRANSLATION|SXF_TRANSFERALPHA|SXF_TRANSFERRENDERSTYLE|SXF_TRANSFERSCALE|SXF_NOCHECKPOSITION);
		let marineSpawnedActor = PBMarine(marineSpawned);
		if (marineSpawnedActor) {
			marineSpawnedActor.setHealth = true;
			marineSpawnedActor.health = self.health;
			if(marineSpawnedActor.target && marineSpawnedActor.target is "PlayerPawn" && marineSpawnedActor.speed == 0){
				marineSpawnedActor.A_ClearTarget();
				marineSpawnedActor.SetState(ResolveState("Spawn"));
				//ForgetTarget
			}
			if (WeaponAmmoLoaded && setAmmo){
				marineSpawnedActor.WeaponAmmoLoaded = self.WeaponAmmoLoaded;
				marineSpawnedActor.setAmmo = true;
			}
			if(tracer){tracer.master = marineSpawnedActor;marineSpawnedActor.tracer = self.tracer;}
			if(reloadingAction){reloadingAction.master = marineSpawnedActor;reloadingAction.target = marineSpawnedActor;marineSpawnedActor.reloadingAction = self.reloadingAction;}
			if(delayFireFX){delayFireFX.master = marineSpawnedActor;delayFireFX.target = marineSpawnedActor;marineSpawnedActor.delayFireFX = self.delayFireFX;}
			if(fireAction){fireAction.master = marineSpawnedActor;fireAction.target = marineSpawnedActor;marineSpawnedActor.fireAction = self.fireAction;}
			if(self.GetTag() != self.GetClassName()){
				marineSpawnedActor.SetTag(self.GetTag());
			}
			if(setWeaponArray){
				marineSpawnedActor.WeaponArray.Copy(self.WeaponArray);
				marineSpawnedActor.WeaponAmmoLoadedArray.Copy(self.WeaponAmmoLoadedArray);
				marineSpawnedActor.MagazineMaxFillArray.Copy(self.MagazineMaxFillArray);
				marineSpawnedActor.setWeaponArray = true;
				marineSpawnedActor.setVoicePitch = setVoicePitch;
				marineSpawnedActor.voicePitch = voicePitch;
			}
			if(FindInventory("PB_PowerStrength")){
				marineSpawnedActor.GiveInventory("PB_PowerStrength",1);
			}
			marineSpawnedActor.EnemyArray.Copy(self.EnemyArray);
			if (setArmor){
				marineSpawnedActor.setArmor = true;
				Let ArmorPtr = BasicArmor(marineSpawnedActor.FindInventory("BasicArmor"));
				if (ArmorPtr){
					marineSpawnedActor.GiveInventory("BasicArmor", CountInv("BasicArmor"));
					if(marineSpawnedActor.FindInventory("BasicArmor")){
						Let ArmorPtrNew = BasicArmor(marineSpawnedActor.FindInventory("BasicArmor"));
						if(ArmorPtrNew){
							ArmorPtrNew.SavePercent = ArmorPtr.SavePercent;
						}
					}
				}
			}
		}
	}
	void A_Pathfind(){
		if(PathfinderPointer){return;}
		if(self is "Marine_Minigun"){A_StopSound(1);}
		if(self is "Marine_Nailgun"){A_StopSound(CHAN_BODY);}
		A_DebugLog("A_Pathfind called");
		actor pathfinder; bool b;
		if (target is "PlayerPawn"){
			[b, pathfinder] = A_SpawnItemEx("AllyPathfinder",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS,0);
		}
		let pathfinderActor = AllyPathfinder(pathfinder);
		if (pathfinderActor){
			pathfinderActor.master = self;
			if(self.master && self.master is "PlayerPawn"){
				pathfinderActor.target = self.master;
			}
			pathfinderActor.allyClass = self.getClass();
			pathfinderActor.A_SetSize(GetDefaultbyType(self.getClass()).height,GetDefaultbyType(self.getClass()).radius);
			PathfinderPointer = pathfinderActor;
			
		}
	}
