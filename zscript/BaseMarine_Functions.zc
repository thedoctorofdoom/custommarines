extend class PBMarine{
	void A_SetMarineSprite(String str){self.sprite = GetSpriteIndex(str);}
	void A_SetMarineFrame(int frame){self.frame = frame;}
	void A_DebugLog(string toLog){if(DebugIsOn()){A_Log(toLog);}}
	void D_DoMarineFireFX(class<Actor> EffectActor, int ShotCount = 0){
		bool a; actor b;
		[a,b] = A_SpawnItemEx(EffectActor,0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
		if(b){
			self.fireAction = b;
			let fire_Action = MarineFireFX(self.fireAction);
			if(fire_Action && ShotCount > 0){fire_Action.ShotCount = ShotCount;}
		}
	}
	state A_JumpIfFireAction(statelabel JumpState){
		if(fireAction){
			return ResolveState(JumpState);
		}else{return ResolveState(null);}
	}
	void A_MakeNotShootable(){
		//A_ChangeFlag("SHOOTABLE", 0);
		bSHOOTABLE = false;
		//bNOTARGET = true;
	}
	void A_MakeShootable(){
		//A_ChangeFlag("SHOOTABLE", 1);
		bSHOOTABLE = true;
		//bNOTARGET = false;
	}
