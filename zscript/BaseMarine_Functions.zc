	bool MarineTargetWeaponCheck(){
	//PB_Carbine
		bool downgradeCheck;
		if(!PBCM_CVarCompat.GetBoolOr('pb_keepweapons') && target && self.MarineWeapon){
			downgradeCheck = (self.MarineWeapon is "PB_Carbine" && target.FindInventory("PB_LMG") || self.MarineWeapon is "PB_Revolver" && target.FindInventory("PB_Deagle") || self.MarineWeapon is "PB_SSG" && target.FindInventory("PB_QuadSG"));
		}
		return (target && self.MarineWeapon && !downgradeCheck);
	}
	bool PlayerDoingWeaponRespect(){
		if(GetCommander().player.FindPSprite(PSP_WEAPON) && InStateSequence(GetCommander().player.FindPSprite(PSP_WEAPON).curstate, GetCommander().player.readyweapon.FindState("WeaponRespect"))){
			A_DebugLog("WeaponRespect");
			return true;
		}
		return false;
	}
	bool PlayerDoingHelmetAnim(){
		if(GetCommander().player && GetCommander().FindInventory("DoingHelmetAnim") ){
			A_DebugLog("DoingHelmetAnim");
			return true;
		}
		return false;
		//return //(
		//return self.target.FindInventory("PB_Pistol") && self.target.FindInventory("RespectPistol") && self.target.FindInventory("RespectRifle");
	}
	state A_JumpIfTargetHasNoMarineWeapon(statelabel jumpState){
		State toJump = ResolveState(jumpState);
		if ( pb_marinesgiveweapons && self.target && self.target is "PlayerPawn" && toJump && MarineTargetWeaponCheck() && !PlayerDoingHelmetAnim() && !PlayerDoingWeaponRespect() && 
			!self.target.FindInventory(MarineWeapon)
		){return toJump;}
		return ResolveState(null);
	}
	void A_GiveTargetMarineWeapon(){
		if ( self.target && self.target is "PlayerPawn" && self.MarineWeapon && (!self.target.FindInventory(MarineWeapon)) ){
			self.target.A_GiveInventory(MarineWeapon);
		}
	}
	Action state A_JumpStrafeRight(statelabel strafeRight = "StrafeRight"){
		State strafeRightState = ResolveState(strafeRight);
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, self.radius) && strafeRightState){
			return strafeRightState;
		}
		return ResolveState(null);
	}
	Action state A_JumpStrafeRetreat(statelabel strafeLeft = "StrafeLeft",statelabel strafeRight = "strafeRight",statelabel retreat = "Retreat"){
		bool LeftAvailable = false;
		bool RightAvailable = false;
		bool RetreatAvailable = false;
		State strafeLeftState = ResolveState(strafeLeft);
		State strafeRightState = ResolveState(strafeRight);
		State retreatState = ResolveState(retreat);
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, -self.radius) && strafeLeftState){
			LeftAvailable = true;
		}
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, self.radius) && strafeRightState){
			RightAvailable = true;
		}
		if (!CheckBlock(0, AAPTR_DEFAULT, -self.radius) && retreatState){
			RetreatAvailable = true;
		}
		if(invoker.TargetIsAttackingMelee() && RetreatAvailable){
			return retreatState;
		}
		if (RetreatAvailable && LeftAvailable && RightAvailable){
			int randomInt = random(0,2);
			if (randomInt == 0){
				return retreatState;
			} else if (randomInt == 1){
				return strafeLeftState;
			} else if (randomInt == 2){
				return strafeRightState;
			}
		}
		if (RetreatAvailable && LeftAvailable && !RightAvailable){
			if (random(0,1)>0){return strafeLeftState;}
			else{return retreatState;}
		}
		if (RetreatAvailable && RightAvailable && !LeftAvailable){
			if (random(0,1)>0){return strafeRightState;}
			else{return retreatState;}
		}
		if (!RetreatAvailable && RightAvailable && LeftAvailable){
			if (random(0,1)>0){return strafeRightState;}
			else{return strafeLeftState;}
		}
		if (!RetreatAvailable && LeftAvailable && !RightAvailable){
			return strafeLeftState;
		}
		if (!RetreatAvailable && RightAvailable && !LeftAvailable){
			return strafeRightState;
		}
		if (RetreatAvailable && !RightAvailable && !LeftAvailable){
			return retreatState;
		}
		return ResolveState(null);
	}
	Action state A_JumpStrafe(statelabel strafeLeft = "StrafeLeft",statelabel strafeRight = "StrafeRight"){
		bool LeftAvailable = false;
		bool RightAvailable = false;
		State strafeLeftState = ResolveState(strafeLeft);
		State strafeRightState = ResolveState(strafeRight);
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, -self.radius) && strafeLeftState){
			LeftAvailable = true;
		}
		if (!CheckBlock(0, AAPTR_DEFAULT, 0, self.radius) && strafeRightState){
			RightAvailable = true;
		}
		if (RightAvailable && LeftAvailable){
			if (random(0,1)>0){return strafeRightState;}
			else{return strafeLeftState;}
		}
		if (LeftAvailable && !RightAvailable){
			return strafeLeftState;
		}
		if (RightAvailable && !LeftAvailable){
			return strafeRightState;
		}
		return ResolveState(null);
	}
	Action state A_JumpStrafeChance(int chance, statelabel strafeLeft = "StrafeLeft",statelabel strafeRight = "StrafeRight"){
		if ( invoker.speed > 0 && (random(0,255) < chance || invoker.TargetIsAttackingRanged()) ){return A_JumpStrafe(StrafeLeft,StrafeRight);}
		else{return ResolveState(null);}
	}
	Action void A_AllySpawnProjectile(class<Actor> missiletype,double spawnheight = 32,double spawnofs_xy = 0,double angle = 0,int flags = CMF_AIMDIRECTION,double pitch = 0,int ptr = AAPTR_TARGET){
		if(!missiletype){return;}
		class<Actor> missileToFire = GetReplacement(missiletype); 
		actor proj;
		if (target && target.health > 0){A_FaceTarget(0,180,0,0);proj = A_SpawnProjectile(missileToFire,spawnheight,spawnofs_xy,angle,0,pitch,ptr);}
		else{proj = A_SpawnProjectile(missileToFire,spawnheight,spawnofs_xy,angle,flags,pitch,ptr);}
		if (proj){
			proj.species = invoker.GetCommander().GetSpecies();
			proj.bDONTHARMCLASS = true;proj.bDONTHARMSPECIES = true;proj.bTHRUSPECIES = true;proj.bMTHRUSPECIES = true;proj.bDOHARMSPECIES = false;
		}
	}
	Action void A_StartVoiceLine(sound whattoplay, int slot = CHAN_BODY, int flags = CHANF_DEFAULT, double volume = 1.0, double attenuation = ATTN_NORM, double pitch = 0, double startTime = 0){
		if(pb_quietmarines)return;
		else if(master && invoker.GetCommander().CountInv("ShutTheFuckUp") < 1){
			//flags |= CHANF_SINGULAR;
			//CHANF_SINGULAR
			if(pitch == 0 && invoker.setVoicePitch){
				A_StartSound(whattoplay, slot, flags, volume, attenuation, invoker.voicePitch, startTime);
			}else{
				A_StartSound(whattoplay, slot, flags, volume, attenuation, pitch, startTime);
			}
			if(Distance3D(master) <= 1000){
				int sndtics = S_GetLength(whattoplay) * TICRATE;
				master.A_SetInventory("ShutTheFuckUp",sndtics);
			}
		}
		return;
	}
	Action void A_StartSoundIfNoVoice(sound whattoplay, int slot = CHAN_BODY, int flags = CHANF_DEFAULT, double volume = 1.0, double attenuation = ATTN_NORM, double pitch = 0, double startTime = 0){
		if(pb_quietmarines){A_StartSound(whattoplay, slot, flags, volume, attenuation, pitch, startTime);}
		return;
	}
	void A_AllyAlertMonsters(float maxrange,int flags){
		//flags |= AMF_TARGETEMITTER;
		bSHOOTABLE = true;
		self.A_AlertMonsters(0,AMF_TARGETEMITTER);
		PB_AlertMonsters();
	}
	action void PB_AlertMonsters(){
		invoker.A_AlertMonsters(0,AMF_TARGETEMITTER);
	}
	int CheckTargetSurroundingEnemies(double rad = 256){
		if (!target)
			return 0;
		int ret = 0;
		let itr = BlockThingsIterator.Create(target, rad);
		while (itr.Next()){
			let thing = itr.thing;
			if (thing && thing.bISMONSTER && thing.health > 0 && thing.GetSpecies() != "Marines" && thing.Distance3D(target) <= rad && target.CheckSight(thing)){
				ret++;
			}
		}
		return ret;
	}
	int CheckTargetSurroundingAllies(double rad = 256){
		if (!target) return 0;
		int ret = 0;
		let itr = BlockThingsIterator.Create(target, rad);
		while (itr.Next()){
			let thing = itr.thing;
			if (thing && thing.health > 0 && thing.GetSpecies() == "Marines" && thing.Distance3D(target) <= rad && target.CheckSight(thing)){
				ret++;
			}
		}
		return ret;
	}
