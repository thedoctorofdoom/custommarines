	 void D_DoMarineWeaponDelayFX(class<PB_WeaponBase> WeaponSelected = null, class<Actor> EffectActor = null){
		A_DebugLog("D_DoMarineWeaponDelayFX called");
		bool a; actor b;
		if(!WeaponSelected && self.MarineWeapon){WeaponSelected = self.MarineWeapon;}
		if(WeaponSelected && EffectActor){ //comment out EffectActor when fully implemented
			//if(!EffectActor){EffectActor = D_GetReloadFX(WeaponSelected);} //replace with a fire delay fx
			int weapIndex = WeaponArray.Find(WeaponSelected);
			if (!self.delayFireFX && EffectActor && EffectActor is "MarineDelayFireFX" ){
				[a,b] = A_SpawnItemEx(EffectActor,0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
				if (b){self.delayFireFX = b;}
			}
		}
	}
