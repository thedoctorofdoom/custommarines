	void D_DoMarineDelayFireFX(class<Actor> EffectActor){
		bool a; actor b;
		if(EffectActor){
			if (!self.delayFireFX && EffectActor && (EffectActor is "MarineDelayFireFX" || EffectActor is "MarineFireFX") ){
				[a,b] = A_SpawnItemEx(EffectActor,0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION);
				if(b){self.delayFireFX = b;}
			}
		}
	}
	//MarineWeaponFX.zc
	action bool actorCanBeExecuted(Actor monster) {
		if(monster is "PlayerPawn" || monster.GetSpecies() == "Marines" || monster.GetSpecies() == "Marine"){return false;}
		int targetMaxHealth = monster.spawnHealth();
		int targetCurrentHealth = monster.health;
		if(CheckInventory("PB_PowerStrength",1) && (targetCurrentHealth <= targetMaxHealth*0.25 || targetCurrentHealth <= 150)) {
			return true;
		}
		if(targetCurrentHealth < targetMaxHealth*0.20 || targetCurrentHealth <= 60) {
			return true;
		}
		return false;
	}
	action StateLabel PB_ExecuteGeneric() {
		StateLabel result;
		int selector = (random(1,4));
		FLineTraceData RemoteRay;
		bool wallcheck = LineTrace(
			angle,
			120,
			pitch,
			TRF_THRUACTORS,
			offsetz: height-12,
			data: RemoteRay
		);
		result = "Execution_Generic";
		return result;
	}
	action void PB_UnsetMarineExecutionProperties(){
		//PlayerInfo self = PlayerPawn(self).player;
		//self.cheats &= ~(CF_TOTALLYFROZEN|CF_NOTARGET|CF_GODMODE|CF_INSTANTWEAPSWITCH|CF_DOUBLEFIRINGSPEED|CF_FRIGHTENING  );
		self.bNODAMAGE = false;
		self.bNOPAIN = false;
		//PB_SetExecutingEnemy(false);
		//Determine how much health is returned (risk vs. reward)
		if (self.health < 25) {
			A_GiveInventory("HealthBonus",20);
		}
		else if (self.health < 50 && self.health >= 25) {
			A_GiveInventory("HealthBonus",15);
		}
		else if (self.health < 100 && self.health >= 50) {
			A_GiveInventory("HealthBonus",10);
		}
		else if (self.health < 200 && self.health >= 100) {
			A_GiveInventory("HealthBonus",5);
		}
		else {
			A_GiveInventory("HealthBonus",1);
		}
	}
	void A_AllyChaseSee(statelabel melee = '_a_chase_default', statelabel missile = '_a_chase_default',int flags = 0){//ChaseFireAbility()
		A_DebugLog("A_AllyChaseSee called");
		if( ((AllyAttackCooldown > 0) || A_CannotFire() ) //delayFireFX || (reloadingAction && reloadingAction is "MarineReloadFX")
		&& !(target is "PlayerPawn" || target is "PBMarine" || target is "PB_CapturedMarine") ){A_Chase("Missile.NoFire","Missile.NoFire",flags);}
		else{A_Chase(melee,missile,flags);}
		return;
	}
	void A_AllyChaseFollow(statelabel melee = '_a_chase_default', statelabel missile = '_a_chase_default',int flags = 0){
		A_DebugLog("A_AllyChaseFollow called");
		A_Chase(melee,missile,flags);
		return;
	}
	void A_AllyChaseGuard(statelabel melee = '_a_chase_default', statelabel missile = '_a_chase_default',int flags = 0){
		A_DebugLog("A_AllyChaseGuard called");
		flags |= CHF_DONTMOVE;
		if( ((AllyAttackCooldown > 0) || A_CannotFire() )
		&& !(target is "PlayerPawn" || target is "PBMarine" || target is "PB_CapturedMarine") ){A_Chase("Missile.NoFire","Missile.NoFire",flags);}
		else if(target is "PlayerPawn" || target is "PBMarine" || target is "PB_CapturedMarine") {A_Chase("MarineSequenceGuarding","MarineSequenceGuarding",flags);}
		else{A_Chase(melee,missile,flags);}
		return;
	}
