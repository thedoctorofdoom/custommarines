		#### # 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL3 E 10 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		#### # 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
