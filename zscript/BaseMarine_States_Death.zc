	Death.plasma:
		#### # 0 {A_XScream();A_NoBlocking();}
		---- AAA 0 A_CustomMissile("Brutal_FlyingBlood", 50, 0, random (0, 360), 2, random (0, 160));
		#### # 0 {
			A_CustomMissile("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160));
			A_CustomMissile("XDeathBurnedLeg", 32, 0, random (0, 360), 2, random (0, 160));
