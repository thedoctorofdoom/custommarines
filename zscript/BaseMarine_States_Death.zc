		TNT1 A 1 {A_SpawnItem("GrowingBloodPool");A_SpawnItem("CrushedRemains");}
		TNT1 A 1 A_XScream();
		TNT1 A 1 A_NoBlocking();
		Stop;
	Death.Blast:
	Death.SuperPunch:
