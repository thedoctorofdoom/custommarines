extend class PBMarine{
	States{
	Crush:
		CRS1 A 5 A_PlaySound("misc/xdeath4");
		CRS1 A -1;
		Stop;
	Death:
	Death.Bullet:
		PLAY H 10 {A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));A_ChangeFlag("FRIENDLY", 0);A_ChangeFlag("USESPECIAL", 0);A_PlayerScream();}
		PLAY I 10 A_NoBlocking();
		PLAY JKLM 10;
		#### N -1 A_SpawnItem("MediumBloodSpot");
		Stop;
	Death.Eat:
		XPL1 A 10 {A_GiveToTarget("EatMe",1);A_CustomMissile("XDeath1", 1, 0, random (0, 360), 2, random (0, 160));A_CustomMissile("XDeath4", 1, 0, random (0, 360), 2, random (0, 160));A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));A_XScream();}
		XPL1 B 20 A_NoBlocking();
		XPL1 CDE 10 ;
		XPL1 E -1 A_SpawnItem("MediumBloodSpot");
		Stop;
	Death.Cut:
	Death.Saw:
		#### # 0 {
			A_CustomMissile("XDeath1", 1, 0, random (0, 360), 2, random (0, 160));
			A_CustomMissile("XDeath2", 1, 0, random (0, 360), 2, random (0, 160));
			A_CustomMissile("XDeath3", 1, 0, random (0, 360), 2, random (0, 160));
