		TNT1 AAAAAAAAAAA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL3 A 10 A_XScream();
		TNT1 AAAAA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
