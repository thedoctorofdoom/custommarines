		PLAY O 2 A_FaceTarget;
		TNT1 AAAA 0 {
			A_CustomMissile("XDeath1", 32, 0, random (170, 190), 2, random (0, 40));
			A_CustomMissile("XDeath2", 32, 0, random (170, 190), 2, random (0, 40));
			A_CustomMissile("XDeath3", 32, 0, random (170, 190), 2, random (0, 40));
