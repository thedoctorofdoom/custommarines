		TNT1 AA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL2 C 10 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		TNT1 AA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL2 DE 10 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL2 E -1 A_SpawnItem("MediumBloodSpot");
		Stop;
	Death.GreenFire:
		#### # 0 {A_XScream();A_NoBlocking();}
		TNT1 AAAA 0 A_CustomMissile("Brutal_Blood", 30, 0, random (0, 360), 2, random (0, 160));
		#### # 0 {
			A_CustomMissile("XDeathBurnedArm", 32, 0, random (0, 360), 2, random (0, 160));
			A_CustomMissile("XDeathBurnedLeg", 32, 0, random (0, 360), 2, random (0, 160));
