			A_CustomMissile("Brutal_FlyingBloodMuchFaster", 32, 0, random (170, 190), 2, random (0, 40));
			A_CustomMissile("SuperWallRedBlood", 32, 0, random (170, 190), 2, random (0, 40));
			A_CustomMissile("SuperWallRedBlood", 46, 0, random (170, 190), 2, random (0, 40));
		}
		#### # 0 A_CustomMissile("XDeathArm1", 32, 0, random (170, 190), 2, random (0, 40));
		#### # 0 A_XScream();
		#### # 0 A_NoBlocking();
		PLAY OPQRSTU 8;
		#### # 0 A_SpawnItem("MediumBloodSpot");
		PLAY U -1;
		Stop;
	Death.Destruction:
		TNT1 AAAAAAAAAAAAAA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL4 A 20 A_XScream();
		#### # 0 {A_CustomMissile("XDeath1", 1, 0, random (0, 360), 2, random (0, 160));A_CustomMissile("XDeath2", 1, 0, random (0, 360), 2, random (0, 160));A_CustomMissile("XDeath3", 1, 0, random (0, 360), 2, random (0, 160));A_CustomMissile("XDeath4", 1, 0, random (0, 360), 2, random (0, 160));}
		TNT1 AAAA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
		XPL4 B 20 A_NoBlocking();
		TNT1 AAA 0 A_CustomMissile("MuchBlood", 50, 0, random (0, 360), 2, random (0, 160));
