Class PoleWithNothing : Actor{
	Default{
		Mass 99999999;
		+NOBLOCKMAP
	}
	States{
	Spawn:
			TNT1 A 0 A_Stop;
			TNT1 A 0 A_SpawnItem("PoleWithNothing2", 0, -40);
			Stop;
	}
}

Class PoleWithNothing2 : PoleWithNothing{
	States{
	Spawn:
			CAPT N 1 A_Stop;
			CAPT N -1;
			Stop;
	}
}