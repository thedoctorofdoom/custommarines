Class PB_CapturedMarine: SwitchableDecoration{
	mixin PB_RandomMarineNameHandler;
	mixin PB_MarineSpawnHandler;
	Class<PBMarine> MarineType;
	String MarineTypeString;
	void SetMarineType(string marineTypeToSet){
		if(marineTypeToSet && debugLog){A_Log(string.format("SETTING MARINE TYPE"));}
		class<PBMarine> toSet = marineTypeToSet;
		if(toSet){
			if(debugLog){A_Log(string.format("Setting successful"));}
			self.MarineTypeString = marineTypeToSet;
			self.MarineType = toSet;
			//if(self.GetTag() == self.GetClassName()){
			let toSet2 = PBMarine(GetDefaultByType(toSet));
			if(toSet2 && toSet2.MarineWeapon){
				let MarineWeaponToTag = GetDefaultByType(toSet2.MarineWeapon);
				if(MarineWeaponToTag){
					string weaponTag = MarineWeaponToTag.GetTag();
					SetTag(string.format("%s [%s]",PickRandomName(RANK_MILITARY),weaponTag));
				}
			}else{SetTag(PickRandomName(RANK_MILITARY));}
			//}
		}
	}
	void SelectMarineType(){
		Stats = PB_GlobalStats.Get();
		int Count = PB_GlobalStats.Get().Counters[PB_GlobalStats.Counter_LevelsCompleted];
		if(self.cursector.IsSecret()){
			Count += (levelsToPlay/4);
			if(debugLog){A_Log("Is Secret");}
		}
		Count = Clamp(Count,1,levelsToPlay);
		string msg = String.Format("Tier Count: %d", Count);
		if(debugLog){A_Log(msg);}
		if(SpawnBalance==663){SetMarineType(Marine_Chaotic_Random_Name_List[random(0,Marine_Chaotic_Random_Name_List.size()-1)]);}
		else if(SpawnBalance==666 || SpawnBalance<=663 && SpawnBalance>=672){
			if(Count < (levelsToPlay / 4)) {SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);}
			else if(Count == (levelsToPlay / 4)) {
				if(random(0,3) > 0){SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
			}
			else if(Count == ((levelsToPlay / 4) + 1)) {
				if(random(0,1) > 0){SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);}
			}
			else if(Count == ((levelsToPlay / 4) + 2)) {
				if(random(0,3) > 0){SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);}
			}
			else if(Count < ((levelsToPlay / 4) * 2)) {SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
			
			else if(Count == ((levelsToPlay / 4) * 2)) {
				if(random(0,3) > 0){SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			}
			else if(Count == (((levelsToPlay / 4) * 2) + 1)) {
				if(random(0,1) > 0){SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			}
			else if(Count == (((levelsToPlay / 4) * 2) + 2)) {
				if(random(0,3) > 0){SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
			}
			else if(Count < ((levelsToPlay / 4) * 3)) {SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			
			else if(Count == ((levelsToPlay / 4) * 3)) {
				if(random(0,3) > 0){SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);}
			}
			else if(Count == (((levelsToPlay / 4) * 3) + 1)) {
				if(random(0,1) > 0){SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			}
			else if(Count == (((levelsToPlay / 4) * 3) + 2)) {
				if(random(0,3) > 0){SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);}
				else{SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			}
			else if(Count > (((levelsToPlay / 4) * 3) + 2)) {SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);}
		}
		else if(SpawnBalance==667){
			SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);
		}
		else if(SpawnBalance==668){
			SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);
		}
		else if(SpawnBalance==669){
			SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);
		}
		else if(SpawnBalance==670||SpawnBalance==672){
			SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);
		}
		else if(SpawnBalance==671){
			if(Count <= (levelsToPlay / 4)) {SetMarineType(Marine_T1_Name_List[random(0,Marine_T1_Name_List.size()-1)]);}
			else if(Count <= (levelsToPlay / 4 * 2)) {SetMarineType(Marine_T2_Name_List[random(0,Marine_T2_Name_List.size()-1)]);}
			else if(Count <= (levelsToPlay / 4 * 3)) {SetMarineType(Marine_T3_Name_List[random(0,Marine_T3_Name_List.size()-1)]);}
			else if(Count > (levelsToPlay / 4 * 3)) {SetMarineType(Marine_T4_Name_List[random(0,Marine_T4_Name_List.size()-1)]);}
		}
		if( NazisOnMap() ){SetMarineType(Marine_Wolfenstein_Name_List[random(0,Marine_Wolfenstein_Name_List.size()-1)]);}
	}
	override int TakeSpecialDamage(Actor inflictor, Actor source, int damage, name damagetype){
		if(inflictor is "KnifeSwing" && source is "PlayerPawn" || inflictor is "PlayerPawn") return 0;
		else return super.TakeSpecialDamage(inflictor, source, damage, damagetype);
	}
	PB_GlobalStats Stats;
	override void PostBeginPlay(){
		if(!MarineTypeString){
			InitializeMarineLists();
			SelectMarineType();
		}
		if(MarineType){
			let def = GetDefaultByType(MarineType);
			if (!def){A_Log("Destroyed");Destroy();return;}
			self.scalex = def.scalex;
			self.scaley = def.scaley;
			self.translation = def.translation;
		}
		A_GiveInventory("TargetIsAMarine");
		Super.PostBeginPlay();
	}
	void A_SpawnMarine(){
		if(MarineType){
			actor MarineActor; bool b;
			class<PBMarine> toSet = self.MarineTypeString;
			if (MarineType is "PBMarine"){
				[b,MarineActor] = A_SpawnItemEx("Marine_Spawn",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION | SXF_TRANSFERSPECIAL | SXF_TRANSFERAMBUSHFLAG | 288,0,tid);
				let Actor_Spawn = Marine_Spawn(MarineActor);
				if(MarineActor && self.GetTag() != self.GetClassName()){MarineActor.SetTag(self.GetTag());}
				class<PBMarine> SpawnedActorMarine = self.MarineTypeString;
				if(Actor_Spawn && SpawnedActorMarine){
					Actor_Spawn.MarineType = SpawnedActorMarine;
					Actor_Spawn.master = players[0].mo;
					Actor_Spawn.target = players[0].mo;
				}
			}
		}
		else{A_SpawnItemEx("PBMarineSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);}
	}
	Default{
	+LOOKALLAROUND;
	Monster; 
	-SOLID;
	-NOTIMEFREEZE;
	-COUNTKILL;
	+FORCEXYBILLBOARD;
	//Radius 24;
	ProjectilePassHeight 48;
	Health 300;
	Scale 1.0;
	Decal "BloodSuper";
	Species "Marines";
	Painchance 255;
	DamageType "Taunt";
	damagefactor "Trample", 0.0;
	damagefactor "Cut", 10.0;
	damagefactor "Taunt", 0.0;
	damagefactor "headcut", 0.0;
	damagefactor "KillMe", 0.0;
	damagefactor "Fatality", 99.0;
	damagefactor "Melee", 99.0;
	damagefactor "Kick", 99.0;
	damagefactor "GibRemoving", 0.0;
	damagefactor "TeleportRemover", 0.0;
	DamageFactor "CauseObjectsToSplash", 0.0;
	DeathSound "*death";
	PainSound "*pain50";
	BloodType "Brutal_Blood";
	Activation THINGSPEC_Activate;
	//DropItem "PoleWithNothing", 255;
	Mass 999999;
	Speed 0;
	+SHOOTABLE
	+FLOORCLIP
	+SOLID
	-FRIENDLY
	-COUNTKILL
	+FLOORCLIP
	+THRUSPECIES
	+USESPECIAL
	}
	Override void Die(Actor source, Actor inflictor, int dmgflags, Name MeansOfDeath){
		bUSESPECIAL = false;
		Super.Die(source, inflictor, dmgflags, MeansOfDeath);
	}
